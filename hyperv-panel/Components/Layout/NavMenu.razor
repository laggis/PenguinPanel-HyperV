@inject UserSession Session
@inject PanelService Panel
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="brand">
    <div class="brand-mark">PG</div>
    <div>
        <strong>🐧 PenguinPanel</strong>
        <span>Virtual server panel</span>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span>⌂</span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="vms">
                <span>▣</span> Virtual Servers
            </NavLink>
        </div>

        @if (IsAdminUser())
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="create-vps">
                    <span>＋</span> Create VPS
                </NavLink>
            </div>
        }

        @if (Session.IsLoggedIn)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="account">
                    <span>○</span> Account
                </NavLink>
            </div>
        }

        @if (IsAdminUser())
        {
            <div class="nav-section-title">Admin</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="users">
                    <span>☷</span> User Manager
                </NavLink>
            </div>


            <div class="nav-item">
                <NavLink class="nav-link" href="templates">
                    <span>▤</span> OS Templates
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="abuse">
                    <span>⚑</span> Abuse Protection
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="logs">
                    <span>≡</span> Audit Logs
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="settings">
                    <span>⚙</span> Settings
                </NavLink>
            </div>
        }
    </nav>

    @if (Session.IsLoggedIn)
    {
        <button class="nav-logout" @onclick="LogoutAsync">Sign out</button>
    }
</div>

@code {
    private bool IsAdminUser()
    {
        return Session.User?.IsAdmin == true
            || string.Equals(Session.User?.Username, "admin", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LogoutAsync()
    {
        var token = Session.SessionToken;
        if (!string.IsNullOrWhiteSpace(token))
        {
            await Panel.RevokeSessionTokenAsync(token);
        }

        await JS.InvokeVoidAsync("localStorage.removeItem", UserSession.BrowserTokenKey);
        Session.SignOut();
        Navigation.NavigateTo("/login");
    }
}
