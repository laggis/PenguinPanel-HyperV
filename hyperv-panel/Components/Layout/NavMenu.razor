@inject UserSession Session
@inject PanelService Panel
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="brand">
    <div>
        <strong>PenguinPanel</strong>
        <span>VPS Hosting</span>
    </div>
    <button class="menu-toggle" type="button" aria-controls="panel-nav" aria-expanded="@(menuOpen ? "true" : "false")" @onclick="ToggleMenu">Menu</button>
</div>

<div id="panel-nav" class="nav-scrollable @(menuOpen ? "is-open" : "")">
    <nav class="nav" aria-label="Panel navigation" @onclick="CloseMenu">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Dashboard
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="vms">
                Virtual Servers
            </NavLink>
        </div>

        @if (IsAdminUser())
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="create-vps">
                    Create VPS
                </NavLink>
            </div>
        }

        @if (Session.IsLoggedIn)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="account">
                    Account
                </NavLink>
            </div>
        }

        @if (IsAdminUser())
        {
            <div class="nav-section-title">Administration</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="monitoring">
                    Live Monitoring
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="alerts">
                    Alerts &amp; Notifications
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="users">
                    User Manager
                </NavLink>
            </div>


            <div class="nav-item">
                <NavLink class="nav-link" href="templates">
                    OS Templates
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="abuse">
                    Abuse Protection
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="logs">
                    Audit Logs
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="consistency">
                    Consistency Scanner
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="settings">
                    Settings
                </NavLink>
            </div>
        }
    </nav>

    @if (Session.IsLoggedIn)
    {
        <button class="nav-logout" @onclick="LogoutAsync">Sign out</button>
    }
</div>

@code {
    private bool menuOpen;
    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    private bool IsAdminUser()
    {
        return Session.User?.IsAdmin == true
            || string.Equals(Session.User?.Username, "admin", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LogoutAsync()
    {
        var token = Session.SessionToken;
        if (!string.IsNullOrWhiteSpace(token))
        {
            await Panel.RevokeSessionTokenAsync(token);
        }

        await JS.InvokeVoidAsync("localStorage.removeItem", UserSession.BrowserTokenKey);
        Session.SignOut();
        Navigation.NavigateTo("/login");
    }
}
