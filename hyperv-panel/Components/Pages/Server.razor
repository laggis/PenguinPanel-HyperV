    private async Task RestoreCheckpoint(string name)
    {
        if (vm is null || restoreInProgress) return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Restore checkpoint '{name}'?\n\nThis will stop {vm.Name} if it is running, restore the selected checkpoint, and leave the VM stopped. You will need to press Start when you are ready.");

        if (!confirmed)
        {
            return;
        }

        busy = true;
        restoreInProgress = true;
        restoreProgress = 5;
        restoreStatus = "Preparing safe restore...";
        messageClass = "alert success";
        message = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var wasRunningInUi = IsRunningState(vm.State);
            restoreProgress = 20;
            restoreStatus = wasRunningInUi
                ? "Stopping the VM before restore. It will stay stopped afterwards."
                : "VM is already stopped. Restoring checkpoint.";
            await InvokeAsync(StateHasChanged);

            var result = await Panel.RestoreCheckpointAsync(Session.User, vm.Name, name);

            restoreProgress = 80;
            restoreStatus = "Restore completed. Refreshing VM state and restore points...";
            await InvokeAsync(StateHasChanged);

            await Load();

            restoreProgress = 100;
            restoreStatus = result.Message;
            message = result.Message;
            lastAction = result.Message;
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
            lastAction = ex.Message;
            restoreStatus = "Restore failed: " + ex.Message;
        }
        finally
        {
            restoreInProgress = false;
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

