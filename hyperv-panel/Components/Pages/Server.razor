    private bool CanExecuteFullRestore() =>
        !busy
        && !fullBackupInProgress
        && !fullRestoreInProgress
        && pendingFullRestoreBackup is not null
        && string.Equals(fullRestoreConfirmation.Trim(), "RESTORE", StringComparison.Ordinal);

    private async Task ExecuteFullRestore()
    {
        if (vm is null || pendingFullRestoreBackup is null || !CanExecuteFullRestore()) return;

        var target = pendingFullRestoreBackup;
        busy = true;
        fullRestoreInProgress = true;
        fullRestoreProgress = 2;
        fullRestoreStatus = "Preparing full restore...";
        message = null;
        messageClass = "alert success";
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await Panel.RestoreFullBackupAsync(
                Session.User,
                vm.Name,
                target.Id,
                fullRestoreConfirmation,
                async (value, text) =>
                {
                    fullRestoreProgress = value;
                    fullRestoreStatus = text;
                    await InvokeAsync(StateHasChanged);
                });

            fullRestoreProgress = 100;
            fullRestoreStatus = result.Message;
            message = result.Message;
            lastAction = result.Message;
            pendingFullRestoreBackup = null;
            fullRestoreConfirmation = string.Empty;
            await LoadBackups();
            await Load(false);
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
            lastAction = ex.Message;
            fullRestoreStatus = "Restore failed: " + ex.Message;
        }
        finally
        {
            fullRestoreInProgress = false;
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

