@using Microsoft.AspNetCore.Components
@page "/server"
@implements IDisposable
@inject PanelService Panel
@inject UserSession Session
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject GuacamoleJsonAuthService GuacamoleJsonAuth

<PageTitle>Virtual Server</PageTitle>

@if (!Session.IsLoggedIn)
{
    <NotSignedIn />
}
else if (string.IsNullOrWhiteSpace(VmName))
{
    <section class="panel empty-state">
        <h1>No server selected</h1>
        <p>Open a server from the Virtual Servers page.</p>
        <a class="button primary" href="vms">View virtual servers</a>
    </section>
}
else if (loading)
{
    <section class="vm-loading">
        <h1>@VmName</h1>
        <p role="status">Loading server details…</p>
    </section>
}
else if (vm is null)
{
    <section class="panel empty-state">
        <h1>Server unavailable</h1>
        <p>The VM could not be found, or it is not assigned to your account.</p>
        <a class="button primary" href="vms">Back to virtual servers</a>
    </section>
}
else
{
    <div class="server-titlebar">
        <div>
            <span class="eyebrow">Virtual Server</span>
            <h1>@vm.Name</h1>
            <p>Power controls, access details, backups, and reinstall requests for this virtual server.</p>
        </div>
        <div class="server-title-actions">
            <span class="status-chip @StateClass(vm.State)">@PrettyState(vm.State)</span>
            <button class="button" @onclick="() => Load()">Refresh</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageClass">@message</div>
    }

    <div class="server-tabs" role="tablist" aria-label="Server sections">
        @if (CanViewTab("console"))
        {
            <button class='@TabClass("console")' @onclick='() => OpenTab("console")'>Console</button>
        }
        @if (CanViewTab("resources"))
        {
            <button class='@TabClass("resources")' @onclick='() => OpenTab("resources")'>Resources</button>
        }
        @if (CanViewTab("monitoring"))
        {
            <button class='@TabClass("monitoring")' @onclick='() => OpenTab("monitoring")'>Monitoring</button>
        }
        @if (Session.User!.IsAdmin && CanViewTab("health"))
        {
            <button class='@TabClass("health")' @onclick='() => OpenTab("health")'>Health</button>
        }
        @if (CanViewTab("access"))
        {
            <button class='@TabClass("access")' @onclick='() => OpenTab("access")'>Access</button>
        }
        @if (CanViewTab("recovery"))
        {
            <button class='@TabClass("recovery")' @onclick='() => OpenTab("recovery")'>Password Reset</button>
        }
        @if (CanViewTab("network"))
        {
            <button class='@TabClass("network")' @onclick='() => OpenTab("network")'>Network</button>
            <button class='@TabClass("firewall")' @onclick="OpenFirewallTab">Windows Firewall</button>
        }
        @if (CanViewTab("backups"))
        {
            <button class='@TabClass("backups")' @onclick='() => OpenTab("backups")'>Backups</button>
        }
        @if (CanViewTab("reinstall"))
        {
            <button class='@TabClass("reinstall")' @onclick='() => OpenTab("reinstall")'>Reinstall</button>
        }
        @if (CanViewTab("activity"))
        {
            <button class='@TabClass("activity")' @onclick='() => OpenTab("activity")'>Activity</button>
        }
        @if (CanViewTab("settings"))
        {
            <button class='@TabClass("settings")' @onclick='() => OpenTab("settings")'>Settings</button>
        }
    </div>

    <div class="server-grid">
        <aside class="server-sidebar-card">
            <div class="server-icon-box">VM</div>
            <h2>@vm.Name</h2>
            <p>@(Session.User!.IsAdmin ? "Admin access" : "Assigned server")</p>

            <div class="mini-stats">
                <div><span>State</span><strong>@PrettyState(vm.State)</strong></div>
                <div><span>CPU usage</span><strong>@vm.CpuUsage%</strong></div>
                <div><span>Memory</span><strong>@FormatBytes(vm.MemoryAssigned)</strong></div>
                <div><span>Uptime</span><strong>@FormatUptime(vm.Uptime)</strong></div>
                <div class="endpoint-stat"><span>RDP</span><strong>@RdpText()</strong></div>
                @if (networkProfile.EnableFiveM && networkProfile.FiveMExternalPort is > 0)
                {
                    <div class="endpoint-stat"><span>FiveM</span><strong>@FiveMText()</strong></div>
                }
            </div>

            @if (CanUsePowerActions())
            {
                <div class="power-panel">
                    <button class="power start" @onclick='() => Run("start")' disabled='@(!CanRunPowerAction("start"))' title='@PowerActionTitle("start")'>Start</button>
                    <button class="power restart" @onclick='() => Run("restart")' disabled='@(!CanRunPowerAction("restart"))' title='@PowerActionTitle("restart")'>Restart</button>
                    <button class="power stop" @onclick='() => Run("stop")' disabled='@(!CanRunPowerAction("stop"))' title='@PowerActionTitle("stop")'>Stop</button>
                    <button class="power muted-power" @onclick='() => Run("suspend")' disabled='@(!CanRunPowerAction("suspend"))' title='@PowerActionTitle("suspend")'>Pause</button>
                    <button class="power muted-power" @onclick='() => Run("resume")' disabled='@(!CanRunPowerAction("resume"))' title='@PowerActionTitle("resume")'>Resume</button>
                </div>

                @if (powerInProgress)
                {
                    <div class="power-progress-card" aria-live="polite">
                        <div class="power-progress-head">
                            <span>@PowerProgressTitle()</span>
                            <strong>@powerProgress%</strong>
                        </div>
                        <div class="power-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@powerProgress">
                            <span style="@PowerProgressStyle"></span>
                        </div>
                        <p>@powerStatus</p>
                    </div>
                }
            }
            else
            {
                <div class="notice-card compact-notice">Power controls are disabled for your account.</div>
            }
        </aside>

        <main class="server-main-card">
            @if (tabLoading)
            {
                <div class="notice-card compact-notice"><strong>Loading @(TabDisplayName(activeTab))...</strong></div>
            }

            @if (!CanViewTab(activeTab))
            {
                <section class="empty-state">
                    <h2>Section hidden</h2>
                    <p>This tab is not enabled for your account. Ask an administrator to update your User Manager permissions.</p>
                </section>
            }
            else if (activeTab == "console")
            {
                <section>
                    <div class="panel-head">
                        <h2>@(UseHyperVBasicConsole() ? "Hyper-V Console" : "Remote Desktop")</h2>
                        <span class="muted">@(UseHyperVBasicConsole() ? "Boot-level VM display and input through the Hyper-V host" : "RDP console access for this virtual server")</span>
                    </div>

                    @if (UseHyperVBasicConsole())
                    {
                        <div class="hyperv-console-layout">
                            <div class="hyperv-console-card">
                                <div class="hyperv-console-toolbar">
                                    <div>
                                        <span class="dot-live"></span>
                                        <strong>@vm.Name</strong>
                                        <span class="hyperv-console-mode">HYPER-V BASIC SESSION</span>
                                    </div>
                                    <div class="button-row settings-actions">
                                        <button class="button mini" @onclick="RefreshHyperVConsoleNow" disabled="@hyperVConsoleBusy">Refresh</button>
                                        <button class="button mini" @onclick="SendHyperVConsoleCtrlAltDelete" disabled="@hyperVConsoleBusy">Ctrl + Alt + Del</button>
                                        <details class="hyperv-console-key-menu">
                                            <summary class="button mini">Send keys</summary>
                                            <div class="hyperv-console-key-popover">
                                                <button class="button mini" @onclick='() => SendHyperVConsoleShortcut("ctrl-esc")' disabled="@hyperVConsoleBusy">Ctrl + Esc</button>
                                                <button class="button mini" @onclick='() => SendHyperVConsoleShortcut("alt-tab")' disabled="@hyperVConsoleBusy">Alt + Tab</button>
                                                <button class="button mini" @onclick='() => SendHyperVConsoleShortcut("alt-f4")' disabled="@hyperVConsoleBusy">Alt + F4</button>
                                                <button class="button mini" @onclick='() => SendHyperVConsoleShortcut("win")' disabled="@hyperVConsoleBusy">Windows key</button>
                                            </div>
                                        </details>
                                        @if (HasRdpTarget())
                                        {
                                            <a class="button mini" href="@RdpDataUri()" download="@RdpFileName()">Open RDP</a>
                                        }
                                    </div>
                                </div>

                                @if (!IsConsoleAvailableState(vm.State))
                                {
                                    <div class="hyperv-console-offline">
                                        <div class="rdp-monitor-icon offline-monitor">⏻</div>
                                        <h3>The VM is @PrettyState(vm.State)</h3>
                                        <p>Start it and this console will begin showing the Hyper-V video output during boot.</p>
                                        @if (CanUsePowerActions())
                                        {
                                            <button class="button primary" @onclick='() => Run("start")' disabled='@(!CanRunPowerAction("start"))'>Start server</button>
                                        }
                                    </div>
                                }
                                else if (hyperVConsoleFrame is null)
                                {
                                    <div class="hyperv-console-loading">
                                        <div class="server-loading-icon" aria-hidden="true">🐧</div>
                                        <strong>Connecting to the Hyper-V display...</strong>
                                        <p>@(string.IsNullOrWhiteSpace(hyperVConsoleError) ? "Waiting for the first framebuffer from VMMS." : hyperVConsoleError)</p>
                                        <button class="button" @onclick="RefreshHyperVConsoleNow" disabled="@hyperVConsoleBusy">Try again</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="hyperv-console-screen-wrap" style="@HyperVConsoleViewportStyle()">
                                        <img @ref="hyperVConsoleSurface"
                                             class="hyperv-console-screen"
                                             src="@hyperVConsoleFrame.DataUri"
                                             alt="Live Hyper-V console for @vm.Name"
                                             tabindex="0"
                                             draggable="false" />
                                        <div class="hyperv-console-screen-hint">
                                            Click the VM screen to focus it, then type normally. Right-click sends a right mouse click.
                                        </div>
                                    </div>
                                }

                                <div class="hyperv-console-statusbar">
                                    <span>@HyperVConsoleStatusText()</span>
                                    <span>@HyperVConsoleResolutionText()</span>
                                    <span>@HyperVConsoleLastFrameText()</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(hyperVConsoleError))
                                {
                                    <div class="notice-card compact-notice danger-note">
                                        <strong>Console warning</strong>
                                        <p>@hyperVConsoleError</p>
                                    </div>
                                }
                            </div>

                            <aside class="rdp-details-card hyperv-console-access-card">
                                <h3>Windows login</h3>
                                <p class="muted">The console itself has no second login. Use the same Windows credentials you use for Remote Desktop.</p>
                                <div class="server-info-grid single-column-info">
                                    <div><span>Username</span><strong>@ValueOrNotSet(access.Username)</strong></div>
                                    <div><span>Password</span><strong>@PasswordText()</strong></div>
                                    @if (HasRdpTarget())
                                    {
                                        <div><span>RDP fallback</span><strong>@RdpText()</strong></div>
                                    }
                                </div>
                                <div class="button-row settings-actions">
                                    <button class="button" @onclick='() => CopyToClipboard(access.Username, "Username")' disabled="@(string.IsNullOrWhiteSpace(access.Username))">Copy username</button>
                                    <button class="button" @onclick="() => showPassword = !showPassword">@(showPassword ? "Hide password" : "Show password")</button>
                                    <button class="button" @onclick='() => CopyToClipboard(access.Password, "Password")' disabled="@(string.IsNullOrWhiteSpace(access.Password))">Copy password</button>
                                </div>
                            </aside>
                        </div>
                    }
                    else if (!HasRdpTarget())
                    {
                        <div class="notice-card">
                            <strong>RDP is not configured yet</strong>
                            <p>Add the VM IP/hostname and RDP port in the Access tab. No extra software is needed inside the VM, but Windows Remote Desktop must be enabled in the guest OS.</p>
                        </div>
                    }
                    else
                    {
                        <div class="rdp-console-layout">
                            <div class="rdp-console-card">
                                <div class="rdp-screen-header">
                                    <span class="dot-live"></span>
                                    <strong>@vm.Name</strong>
                                    <span>@RdpText()</span>
                                </div>

                                @if (!IsConsoleAvailableState(vm.State))
                                {
                                    <div class="rdp-placeholder-screen rdp-offline-screen">
                                        <div class="rdp-monitor-icon offline-monitor">⏻</div>
                                        <h3>Remote Desktop unavailable while the server is @PrettyState(vm.State)</h3>
                                        <p>Start the virtual server before connecting with Windows Remote Desktop. No browser gateway or separate console service is required.</p>
                                        <div class="button-row big-actions centered-actions">
                                            @if (CanUsePowerActions())
                                            {
                                                <button class="button primary" @onclick='() => Run("start")' disabled='@(!CanRunPowerAction("start"))'>Start server</button>
                                            }
                                            <button class="button" @onclick="() => Load()">Refresh state</button>
                                        </div>
                                    </div>
                                }
                                else if (UseNativeRdpConsole())
                                {
                                    <div class="native-rdp-console">
                                        <div class="native-rdp-hero">
                                            <div class="rdp-monitor-icon native-rdp-icon">▣</div>
                                            <div>
                                                <span class="native-rdp-badge">WINDOWS REMOTE DESKTOP</span>
                                                <h3>Connect to @vm.Name</h3>
                                                <p>Uses the normal Windows Remote Desktop client directly to <strong>@RdpText()</strong>. No Guacamole, browser gateway, connection ID, or separate console account is required.</p>
                                            </div>
                                        </div>

                                        <div class="native-rdp-connection-grid">
                                            <div>
                                                <span>Server</span>
                                                <strong>@RdpText()</strong>
                                            </div>
                                            <div>
                                                <span>Username</span>
                                                <strong>@ValueOrNotSet(access.Username)</strong>
                                            </div>
                                            <div>
                                                <span>Connection</span>
                                                <strong>Direct RDP</strong>
                                            </div>
                                            <div>
                                                <span>Security</span>
                                                <strong>NLA / CredSSP</strong>
                                            </div>
                                        </div>

                                        <div class="button-row big-actions centered-actions native-rdp-actions">
                                            <a class="button primary" href="@RdpDataUri()" download="@RdpFileName()">Connect with Remote Desktop</a>
                                            <button class="button" @onclick='() => CopyToClipboard(access.Password, "RDP password")' disabled="@(string.IsNullOrWhiteSpace(access.Password))">Copy password</button>
                                            <button class="button" @onclick='() => CopyToClipboard(RdpText(), "RDP address")'>Copy address</button>
                                        </div>

                                        <p class="native-rdp-hint">Your browser may download a small <strong>.rdp</strong> file. Open it and Windows will launch Remote Desktop with the address and username already configured. Paste the copied password when Windows asks for it.</p>
                                    </div>
                                }
                                else if (HasEffectiveWebConsoleUrl())
                                {
                                    <div class="web-rdp-frame-shell">
                                        <iframe class="rdp-frame" src="@EffectiveWebConsoleUrl()" title="@ConsoleProvider() remote desktop for @vm.Name" allow="clipboard-read; clipboard-write; fullscreen" allowfullscreen></iframe>
                                        <div class="web-rdp-frame-actions">
                                            <span>@ConsoleModeText()</span>
                                            <a class="button mini" href="@EffectiveWebConsoleUrl()" target="_blank" rel="noopener noreferrer">Open in new tab</a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="native-rdp-console">
                                        <div class="native-rdp-hero">
                                            <div class="rdp-monitor-icon native-rdp-icon">▣</div>
                                            <div>
                                                <span class="native-rdp-badge">NATIVE RDP FALLBACK</span>
                                                <h3>Browser console is unavailable</h3>
                                                <p>The configured browser gateway is not available, so PenguinPanel has safely fallen back to normal Windows Remote Desktop.</p>
                                            </div>
                                        </div>
                                        <div class="button-row big-actions centered-actions native-rdp-actions">
                                            <a class="button primary" href="@RdpDataUri()" download="@RdpFileName()">Connect with Remote Desktop</a>
                                            <button class="button" @onclick='() => CopyToClipboard(access.Password, "RDP password")' disabled="@(string.IsNullOrWhiteSpace(access.Password))">Copy password</button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <aside class="rdp-details-card">
                                <h3>Connection details</h3>
                                <div class="server-info-grid single-column-info">
                                    <div><span>Address</span><strong>@RdpText()</strong></div>
                                    <div><span>Username</span><strong>@ValueOrNotSet(access.Username)</strong></div>
                                    <div><span>Password</span><strong>@PasswordText()</strong></div>
                                </div>
                                <div class="button-row settings-actions">
                                    <button class="button" @onclick='() => CopyToClipboard(RdpText(), "RDP address")'>Copy address</button>
                                    <button class="button" @onclick='() => CopyToClipboard(access.Username, "Username")' disabled="@(string.IsNullOrWhiteSpace(access.Username))">Copy username</button>
                                    <button class="button" @onclick="() => showPassword = !showPassword">@(showPassword ? "Hide password" : "Show password")</button>
                                    <button class="button" @onclick='() => CopyToClipboard(access.Password, "Password")' disabled="@(string.IsNullOrWhiteSpace(access.Password))">Copy password</button>
                                </div>
                            </aside>
                        </div>

                        <div class="terminal-window remote-status-terminal">
                            <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[PenguinPanel]</span> Selected virtual server: @vm.Name</div>
                            <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[State]</span> @PrettyState(vm.State)</div>
                            <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[RDP]</span> @RdpText()</div>
                            <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[Mode]</span> @ConsoleModeText()</div>
                            @if (!string.IsNullOrWhiteSpace(lastAction))
                            {
                                <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[Action]</span> @lastAction</div>
                            }
                        </div>

                    }
                </section>
            }
            else if (activeTab == "resources")
            {
                <section>
                    <div class="panel-head">
                        <h2>Resource usage</h2>
                        <span class="muted">Latest server snapshot</span>
                    </div>
                    <div class="resource-grid">
                        <div class="resource-card">
                            <div class="resource-top"><span>CPU Usage</span><strong>@vm.CpuUsage%</strong></div>
                            <div class="usage-track"><div class="usage-fill" style="width:@(Clamp(vm.CpuUsage))%"></div></div>
                        </div>
                        <div class="resource-card">
                            <div class="resource-top"><span>Memory Assigned</span><strong>@FormatBytes(vm.MemoryAssigned)</strong></div>
                        </div>
                    </div>
                    <div class="server-info-grid">
                        <div><span>Status</span><strong>@(string.IsNullOrWhiteSpace(vm.Status) ? "No extra status" : vm.Status)</strong></div>
                        <div><span>Uptime</span><strong>@FormatUptime(vm.Uptime)</strong></div>
                        <div><span>Assigned memory</span><strong>@FormatBytes(vm.MemoryAssigned)</strong></div>
                        <div><span>Last refresh</span><strong>@lastLoaded.ToLocalTime()</strong></div>
                    </div>
                </section>
            }
            else if (activeTab == "monitoring")
            {
                <section>
                    <div class="panel-head">
                        <div>
                            <h2>Live monitoring</h2>
                            <p class="muted">Current Hyper-V health and I/O rates with stored performance history.</p>
                        </div>
                        <span class="pill @(liveMonitoring is null ? "warning" : "online")">@(liveMonitoring is null ? "Waiting for sample" : "Live")</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(liveMonitoringError))
                    {
                        <div class="alert">@liveMonitoringError</div>
                    }
                    else if (liveMonitoring is null)
                    {
                        <div class="monitoring-loading">
                            <div class="monitoring-pulse" aria-hidden="true"></div>
                            <div><h2>Collecting live data</h2><p>Network and disk speeds need two samples before a rate can be calculated.</p></div>
                        </div>
                    }
                    else
                    {
                        <div class="monitoring-status-row">
                            <span class="pill @StateClass(liveMonitoring.State)">@PrettyState(liveMonitoring.State)</span>
                            <span>Sampled @liveMonitoring.SampledAt.ToLocalTime().ToString("HH:mm:ss")</span>
                            <span>Resource metering @(liveMonitoring.ResourceMeteringEnabled ? "enabled" : "unavailable")</span>
                        </div>

                        <div class="monitoring-host-grid server-monitoring-grid">
                            <article class="monitoring-stat-card">
                                <span>CPU usage</span><strong>@liveMonitoring.CpuUsagePercent%</strong>
                                <div class="usage-track"><div class="usage-fill" style="width:@Clamp(liveMonitoring.CpuUsagePercent)%"></div></div>
                            </article>
                            <article class="monitoring-stat-card">
                                <span>Memory pressure</span><strong>@liveMonitoring.MemoryPressurePercent.ToString("0")%</strong>
                                <div class="usage-track"><div class="usage-fill" style="width:@Clamp((int)liveMonitoring.MemoryPressurePercent)%"></div></div>
                                <small>@FormatBytes(liveMonitoring.MemoryDemandBytes) demand / @FormatBytes(liveMonitoring.MemoryAssignedBytes) assigned</small>
                            </article>
                            <article class="monitoring-stat-card"><span>Network receive</span><strong>@FormatRate(liveMonitoring.NetworkReceiveBytesPerSecond)</strong><small>Send @FormatRate(liveMonitoring.NetworkSendBytesPerSecond)</small></article>
                            <article class="monitoring-stat-card"><span>Virtual disk read</span><strong>@FormatRate(liveMonitoring.DiskReadBytesPerSecond)</strong><small>Write @FormatRate(liveMonitoring.DiskWriteBytesPerSecond)</small></article>
                        </div>

                        <div class="server-info-grid">
                            <div><span>Heartbeat</span><strong class="@(liveMonitoring.IsRunning && !liveMonitoring.HeartbeatHealthy ? "warning-text" : string.Empty)">@liveMonitoring.HeartbeatStatus</strong></div>
                            <div><span>Network adapters</span><strong>@liveMonitoring.ConnectedNetworkAdapterCount / @liveMonitoring.NetworkAdapterCount connected</strong></div>
                            <div><span>Uptime</span><strong>@FormatUptime(liveMonitoring.Uptime)</strong></div>
                            <div><span>Hyper-V status</span><strong>@(string.IsNullOrWhiteSpace(liveMonitoring.Status) ? "No extra status" : liveMonitoring.Status)</strong></div>
                        </div>

                        @if (liveMonitoring.HasWarning)
                        {
                            <div class="notice-card compact-notice warning-note"><strong>Attention recommended.</strong> Check heartbeat, adapter connectivity, or high memory demand. PenguinPanel alerts administrators after the configured confirmation period.</div>
                        }

                        <div class="performance-history-section">
                            <div class="panel-head">
                                <div><span class="eyebrow">Step 3.4.3</span><h2>Performance history</h2><p class="muted">One-minute summaries with automatic long-range downsampling.</p></div>
                                <div class="performance-range-row">
                                    @foreach (var option in PerformanceHistoryRanges)
                                    {
                                        <button class="button @(performanceHistoryHours == option.Hours ? "active" : string.Empty)" @onclick="() => ChangePerformanceHistoryRange(option.Hours)" disabled="@performanceHistoryLoading">@option.Label</button>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(performanceHistoryError)) { <div class="alert">@performanceHistoryError</div> }
                            <div class="performance-summary-grid">
                                <div><span>Average CPU</span><strong>@HistoryPercentAverage(vmPerformanceHistory.Select(item => item.CpuPercent))</strong></div>
                                <div><span>Peak CPU</span><strong>@HistoryPercentPeak(vmPerformanceHistory.Select(item => item.CpuPercent))</strong></div>
                                <div><span>Peak memory pressure</span><strong>@HistoryPercentPeak(vmPerformanceHistory.Select(item => item.MemoryPressurePercent))</strong></div>
                                <div><span>Peak network receive</span><strong>@HistoryRatePeak(vmPerformanceHistory.Select(item => item.NetworkReceiveBytesPerSecond))</strong></div>
                            </div>
                            <div class="performance-chart-grid">
                                <PerformanceLineChart Title="CPU and memory pressure" Subtitle="Average percentage per stored time bucket" Times="@VmHistoryTimes" Series="@VmUtilizationSeries" Unit="%" />
                                <PerformanceLineChart Title="Network throughput" Subtitle="Receive and send rate" Times="@VmHistoryTimes" Series="@VmNetworkSeries" Unit="B/s" />
                                <PerformanceLineChart Title="Virtual disk throughput" Subtitle="Read and write rate" Times="@VmHistoryTimes" Series="@VmDiskSeries" Unit="B/s" />
                            </div>
                        </div>

                        <div class="availability-panel">
                            <div class="panel-head">
                                <div><h2>VPS availability</h2><p class="muted">Unexpected shutdown, extended downtime, guest heartbeat, and recovery tracking.</p></div>
                                <span class="pill @AvailabilityPillClass()">@AvailabilityLabel()</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(availabilityUiMessage))
                            {
                                <div class="alert success">@availabilityUiMessage</div>
                            }

                            @if (availabilityState is null)
                            {
                                <div class="notice-card compact-notice">Availability tracking is collecting its first baseline sample.</div>
                            }
                            else
                            {
                                <div class="server-info-grid">
                                    <div><span>Current state</span><strong>@PrettyState(availabilityState.LastState)</strong></div>
                                    <div><span>Down since</span><strong>@FormatAvailabilityDate(availabilityState.DownSince)</strong></div>
                                    <div><span>Last tracked sample</span><strong>@FormatAvailabilityDate(availabilityState.LastSampleAt)</strong></div>
                                    <div><span>Maintenance silence</span><strong>@MaintenanceText()</strong></div>
                                </div>
                            }

                            @if (Session.User!.IsAdmin)
                            {
                                <div class="availability-maintenance-card">
                                    <div><strong>Maintenance silence</strong><p>Suppress unexpected-stop notifications while you work outside PenguinPanel. The long-downtime reminder waits until this window expires.</p></div>
                                    <div class="inline-form">
                                        <label class="inline-label">Hours<input type="number" min="1" max="720" @bind="availabilityMaintenanceHours" /></label>
                                        <input type="text" @bind="availabilityMaintenanceReason" placeholder="Optional maintenance reason" />
                                        <button class="button" @onclick="SetAvailabilityMaintenance" disabled="@busy">Silence alerts</button>
                                        @if (availabilityState?.IsPlannedNow == true)
                                        {
                                            <button class="button danger" @onclick="ClearAvailabilityMaintenance" disabled="@busy">End silence</button>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="availability-preferences-card">
                                    <div><strong>Your email notifications</strong><p>Messages use the email saved under Account. These choices only affect your account and this VPS.</p></div>
                                    <div class="availability-preference-grid">
                                        <label class="switch-row"><input type="checkbox" @bind="availabilityPreference.Enabled" /> Notifications enabled</label>
                                        <label class="switch-row"><input type="checkbox" @bind="availabilityPreference.NotifyUnexpectedDown" /> Unexpected shutdown</label>
                                        <label class="switch-row"><input type="checkbox" @bind="availabilityPreference.NotifyExtendedDowntime" /> Extended downtime reminder</label>
                                        <label class="switch-row"><input type="checkbox" @bind="availabilityPreference.NotifyGuestUnresponsive" /> Guest OS unresponsive</label>
                                        <label class="switch-row"><input type="checkbox" @bind="availabilityPreference.NotifyRecovery" /> Back-online recovery</label>
                                    </div>
                                    <button class="button primary" @onclick="SaveAvailabilityPreference" disabled="@busy">Save notification choices</button>
                                </div>
                            }

                            <div class="panel-head availability-events-head"><h3>Recent availability events</h3><span class="muted">@availabilityEvents.Count recorded</span></div>
                            @if (availabilityEvents.Count == 0)
                            {
                                <div class="notice-card compact-notice">No availability incident has been recorded for this VPS.</div>
                            }
                            else
                            {
                                <div class="monitoring-table-wrap"><table class="data-table compact-table"><thead><tr><th>Time</th><th>Event</th><th>Details</th></tr></thead><tbody>
                                @foreach (var item in availabilityEvents.Take(10))
                                {
                                    <tr><td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td><span class="pill @AvailabilityEventClass(item.Severity)">@item.Title</span></td><td>@item.Message</td></tr>
                                }
                                </tbody></table></div>
                            }

                            <div class="self-healing-vm-panel">
                                <div class="panel-head">
                                    <div><h3>Safe automatic self-healing</h3><p class="muted">Capped recovery actions; never used during planned maintenance or a security hold.</p></div>
                                    <span class="pill @SelfHealingPillClass()">@SelfHealingLabel()</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(selfHealingUiMessage))
                                {
                                    <div class="alert success">@selfHealingUiMessage</div>
                                }

                                <div class="server-info-grid">
                                    <div><span>VPS opt-in</span><strong>@(selfHealingPreference.Enabled ? "Enabled" : "Disabled")</strong></div>
                                    <div><span>Recovery state</span><strong>@SelfHealingStatusText()</strong></div>
                                    <div><span>Attempts</span><strong>@(selfHealingState?.AttemptCount ?? 0)</strong></div>
                                    <div><span>Next action</span><strong>@FormatAvailabilityDate(selfHealingState?.NextAttemptAt)</strong></div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(selfHealingState?.LastResult))
                                {
                                    <div class="hint-card">@selfHealingState.LastResult</div>
                                }

                                @if (Session.User!.IsAdmin)
                                {
                                    <div class="availability-preferences-card self-healing-vm-settings">
                                        <div><strong>Per-VPS recovery permission</strong><p>The global master switch must also be enabled. Heartbeat Restart is intentionally opt-in and more aggressive than Start recovery.</p></div>
                                        <div class="availability-preference-grid">
                                            <label class="switch-row"><input type="checkbox" @bind="selfHealingPreference.Enabled" /> Allow self-healing for this VPS</label>
                                            <label class="switch-row"><input type="checkbox" @bind="selfHealingPreference.RecoverUnexpectedStop" /> Start after unexpected shutdown</label>
                                            <label class="switch-row"><input type="checkbox" @bind="selfHealingPreference.RecoverUnresponsive" /> Restart after unhealthy heartbeat</label>
                                        </div>
                                        <div class="button-row">
                                            <button class="button primary" @onclick="SaveSelfHealingPreference" disabled="@busy">Save VPS recovery settings</button>
                                            <button class="button" @onclick="ResetSelfHealingState" disabled="@busy">Reset attempts</button>
                                        </div>
                                    </div>

                                    <div class="availability-maintenance-card">
                                        <div><strong>Self-healing safety hold</strong><p>Blocks automatic Start/Restart without changing availability emails. Abuse auto-suspension creates a long security hold automatically.</p></div>
                                        <div class="inline-form">
                                            <label class="inline-label">Hours<input type="number" min="1" max="8760" @bind="selfHealingHoldHours" /></label>
                                            <input type="text" @bind="selfHealingHoldReason" placeholder="Reason for blocking automatic recovery" />
                                            <button class="button" @onclick="SetSelfHealingHold" disabled="@busy">Set safety hold</button>
                                            @if (selfHealingPreference.IsHeld)
                                            {
                                                <button class="button danger" @onclick="ClearSelfHealingHold" disabled="@busy">Clear hold</button>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="panel-head availability-events-head"><h3>Recent self-healing events</h3><span class="muted">@selfHealingEvents.Count recorded</span></div>
                                @if (selfHealingEvents.Count == 0)
                                {
                                    <div class="notice-card compact-notice">No automatic recovery action has been recorded for this VPS.</div>
                                }
                                else
                                {
                                    <div class="monitoring-table-wrap"><table class="data-table compact-table"><thead><tr><th>Time</th><th>Status</th><th>Attempt</th><th>Details</th></tr></thead><tbody>
                                    @foreach (var item in selfHealingEvents.Take(10))
                                    {
                                        <tr><td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td><span class="pill @SelfHealingEventClass(item.Status)">@SelfHealingEventText(item.EventType)</span></td><td>@(item.AttemptNumber == 0 ? "—" : item.AttemptNumber.ToString())</td><td>@item.Message</td></tr>
                                    }
                                    </tbody></table></div>
                                }
                            </div>
                        </div>
                    }
                </section>
            }
            else if (activeTab == "health" && Session.User!.IsAdmin)
            {
                <section>
                    <div class="panel-head">
                        <h2>Health &amp; Repair Centre</h2>
                        <span class="muted">Verify PenguinPanel's Hyper-V, NAT, firewall, RDP and recovery state</span>
                    </div>

                    @if (healthReport is null)
                    {
                        <div class="friendly-empty-state">
                            <div class="empty-illustration">+</div>
                            <div>
                                <h2>No diagnosis yet</h2>
                                <p>Run a full diagnosis to compare this VPS against its saved PenguinPanel network and recovery configuration.</p>
                                <button class="button primary" @onclick="RunHealthDiagnosis" disabled="@busy">Run Full Diagnosis</button>
                            </div>

                            @if (reinstallConfirmPending)
                            {
                                <div class="reinstall-confirm-card full-row" role="alert" aria-live="polite">
                                    <div class="reinstall-confirm-icon" aria-hidden="true">!</div>
                                    <div class="reinstall-confirm-copy">
                                        <strong>Are you sure you want to reinstall this server?</strong>
                                        <p>
                                            This will <strong>permanently erase all files and data</strong> currently stored on this VPS
                                            and install <strong>@pendingReinstallTemplateName</strong>.
                                        </p>
                                        <p class="reinstall-confirm-backup">
                                            Make sure you have a backup of anything important before continuing.
                                        </p>
                                        <div class="reinstall-confirm-summary">
                                            <span>Windows password</span>
                                            <strong>
                                                @(pendingReinstallPasswordWillBeGenerated
                                                    ? "PenguinPanel will generate one and email it to you"
                                                    : "Your chosen password will be used")
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="reinstall-confirm-actions">
                                        <button class="button danger"
                                                @onclick="ConfirmPendingReinstall"
                                                disabled="@(busy || reinstallInProgress)">
                                            Yes, reinstall my server
                                        </button>
                                        <button class="button"
                                                @onclick="CancelPendingReinstall"
                                                disabled="@(busy || reinstallInProgress)">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="notice-card compact-notice @(HealthNoticeClass(healthReport.OverallStatus))">
                            <strong>Overall health: @HealthStatusText(healthReport.OverallStatus)</strong>
                            <p>@HealthSummaryText()</p>
                            <p class="muted">Last checked: @healthReport.CheckedAt.ToLocalTime()</p>
                        </div>

                        <div class="server-info-grid">
                            <div><span>Healthy</span><strong>@HealthCount("healthy")</strong></div>
                            <div><span>Warnings</span><strong>@HealthCount("warning")</strong></div>
                            <div><span>Critical</span><strong>@HealthCount("critical")</strong></div>
                            <div><span>Skipped</span><strong>@HealthCount("skipped")</strong></div>
                        </div>

                        <div class="button-row big-actions">
                            <button class="button" @onclick="RunHealthDiagnosis" disabled="@busy">Run Full Diagnosis</button>
                            <button class="button primary" @onclick="RepairHealthProblems" disabled="@busy">Repair PenguinPanel-managed Problems</button>
                        </div>

                        <div class="notice-card compact-notice">
                            <strong>Safe repair scope</strong>
                            <p>Repair re-applies WinNAT + host firewall, verifies the Windows RDP listener, syncs the VM-side firewall, synchronizes the configured DNS server list, and creates/rotates PenguinRecovery. It deliberately does <strong>not</strong> rewrite the guest IP address or gateway automatically; use Network → Repair guest internet when those settings actually need repair.</p>
                        </div>

                        <div class="table-wrap compact-table-wrap">
                            <table class="data-table compact-table">
                                <thead>
                                    <tr>
                                        <th>Check</th>
                                        <th>Status</th>
                                        <th>Result</th>
                                        <th>Details</th>
                                        <th>Repair</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var check in healthReport.Checks)
                                    {
                                        <tr>
                                            <td><strong>@check.Name</strong></td>
                                            <td><span class="pill @HealthPillClass(check.Status)">@HealthStatusText(check.Status)</span></td>
                                            <td>@check.Summary</td>
                                            <td class="muted">@check.Details</td>
                                            <td>@(check.Repairable ? "Automatic" : "Observe")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (healthRepairResult is not null)
                        {
                            <hr class="soft-line" />
                            <div class="panel-head sub-head">
                                <h2>Last repair run</h2>
                                <span class="muted">@healthRepairResult.Message</span>
                            </div>

                            @if (healthRepairResult.Actions.Count > 0)
                            {
                                <div class="notice-card compact-notice success-note">
                                    <strong>Repair actions</strong>
                                    <ul>
                                        @foreach (var action in healthRepairResult.Actions)
                                        {
                                            <li>@action</li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (healthRepairResult.Warnings.Count > 0)
                            {
                                <div class="notice-card compact-notice danger-note">
                                    <strong>Warnings</strong>
                                    <ul>
                                        @foreach (var warning in healthRepairResult.Warnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    }
                </section>
            }
            else if (activeTab == "access")
            {
                <section>
                    <div class="panel-head">
                        <h2>Server access</h2>
                        <span class="muted">RDP / SSH details for the assigned user</span>
                    </div>
                    <div class="server-info-grid">
                        <div><span>Hostname</span><strong>@ValueOrNotSet(access.Hostname)</strong></div>
                        <div><span>IP address</span><strong>@ValueOrNotSet(access.IpAddress)</strong></div>
                        <div><span>RDP</span><strong>@RdpText()</strong></div>
                        @if (networkProfile.EnableFiveM && networkProfile.FiveMExternalPort is > 0)
                        {
                            <div><span>FiveM</span><strong>@FiveMText()</strong></div>
                        }
                        <div><span>SSH</span><strong>@SshText()</strong></div>
                        <div><span>Username</span><strong>@ValueOrNotSet(access.Username)</strong></div>
                        <div><span>Password</span><strong>@PasswordText()</strong></div>
                        <div><span>Console mode</span><strong>@ConsoleAccessStatus()</strong></div>
                    </div>
                    <div class="button-row settings-actions">
                        <button class="button" @onclick="() => showPassword = !showPassword">@(showPassword ? "Hide password" : "Show password")</button>
                    </div>

                    @if (Session.User!.IsAdmin)
                    {
                        <div class="notice-card compact-notice">
                            <strong>RDP routing</strong>
                            <p><strong>Public:</strong> @RdpText()</p>
                            <p><strong>WinNAT target:</strong> @RdpNatTargetText()</p>
                            <p><strong>Windows listener:</strong> @RdpListenerText()</p>
                            <div class="button-row settings-actions">
                                <button class="button" @onclick="VerifyRdpListener" disabled="@(busy || rdpListenerChecking || rdpListenerChanging || string.IsNullOrWhiteSpace(access.Username) || string.IsNullOrWhiteSpace(access.Password))">@(rdpListenerChecking ? "Checking..." : "Verify Windows RDP listener")</button>
                                <button class="button primary soft" @onclick="SyncRdpPortToPublic" disabled="@(busy || rdpListenerChecking || rdpListenerChanging || string.IsNullOrWhiteSpace(access.Username) || string.IsNullOrWhiteSpace(access.Password))">@(rdpListenerChanging ? "Changing RDP port..." : "Match Windows RDP to public port")</button>
                            </div>
                            <p class="muted">New VPSes use the same public and Windows RDP port for TCP + UDP. Older VPSes may still listen on port 3389. <strong>Match Windows RDP to public port</strong> updates Windows, the guest firewall, and WinNAT together. Any active RDP session can disconnect for a few seconds while Remote Desktop Services restarts.</p>
                        </div>
                    }

                    <hr class="soft-line" />
                    <div class="panel-head sub-head">
                        <h2>Change Remote Desktop password</h2>
                        <span class="muted">Updates Windows and the saved panel password</span>
                    </div>
                    <div class="form-grid">
                        <label>New password<input type="password" @bind="remoteDesktopPassword" autocomplete="new-password" disabled="@busy" /></label>
                        <label>Confirm password<input type="password" @bind="remoteDesktopConfirmPassword" autocomplete="new-password" disabled="@busy" /></label>
                        <div class="form-actions full-row">
                            <button class="button" @onclick="GenerateRemoteDesktopPassword" disabled="@busy">Generate password</button>
                            <button class="button primary" @onclick="ChangeRemoteDesktopPassword" disabled="@(busy || string.IsNullOrWhiteSpace(remoteDesktopPassword))">Change RDP password</button>
                        </div>
                    </div>

                    @if (CanUseEmergencyGuestReset())
                    {
                        <div class="notice-card compact-notice">
                            <strong>Forgot your Windows / RDP password?</strong>
                            <p>You can recover access without installing any software inside the VPS. PenguinPanel uses Hyper-V PowerShell Direct and an email verification code.</p>
                            <div class="button-row settings-actions">
                                <button class="button" @onclick='() => OpenTab("recovery")' disabled="@busy">Open Password Recovery</button>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(access.Notes))
                    {
                        <div class="notice-card access-notes">
                            <strong>Notes</strong>
                            <p>@access.Notes</p>
                        </div>
                    }

                    @if (Session.User!.IsAdmin)
                    {
                        <hr class="soft-line" />
                        <div class="panel-head">
                            <h2>Edit access details</h2>
                            <span class="muted">Visible to assigned users</span>
                        </div>
                                                <div class="form-grid">
                            <label>Hostname<input @bind="accessHost" /></label>
                            <label>IP address<input @bind="accessIp" /></label>
                            <label>Public RDP port<input type="number" @bind="accessRdpPort" /></label>
                            <label>SSH port<input type="number" @bind="accessSshPort" /></label>
                            <label>Username<input @bind="accessUsername" /></label>
                            <label>Password<input type="text" @bind="accessPassword" /></label>
                            @if (UseHyperVBasicConsole())
                            {
                                <div class="notice-card full-row compact-notice">
                                    <strong>Hyper-V Basic Console</strong>
                                    <p>No Guacamole URL, VNC port, connection ID, guest network, or per-VM web-console setting is required. The console is provided directly by the Hyper-V host.</p>
                                </div>
                            }
                            else if (UseNativeRdpConsole())
                            {
                                <div class="notice-card full-row compact-notice">
                                    <strong>Native Windows Remote Desktop</strong>
                                    <p>No Guacamole URL, connection ID, browser gateway, or per-VM web-console setting is required. The Console tab generates its connection directly from this VM's RDP address, port, and username.</p>
                                </div>
                            }
                            else
                            {
                                <label class="full-row">Legacy browser console URL / connection ID<input @bind="accessWebConsoleUrl" placeholder="Optional browser-console URL or Guacamole connection ID." /></label>
                                <div class="notice-card full-row compact-notice">
                                    <strong>Browser console preview</strong>
                                    <p>@ConsolePreviewText()</p>
                                    @if (HasEffectiveWebConsoleUrl())
                                    {
                                        <a class="button mini" href="@EffectiveWebConsoleUrl()" target="_blank" rel="noopener noreferrer">Open current browser console</a>
                                    }
                                </div>
                            }
                            <label class="full-row">Notes<textarea @bind="accessNotes"></textarea></label>
                            <div class="form-actions full-row">
                                <button class="button primary" @onclick="SaveAccess" disabled="@busy">Save access details</button>
                                <button class="button" @onclick="GenerateVmPassword" disabled="@busy">Generate password</button>
                                <button class="button danger" @onclick="ResetStoredPassword" disabled="@(busy || string.IsNullOrWhiteSpace(accessPassword))">Save as new stored password</button>
                            </div>
                        </div>
                    }
                </section>
            }
            else if (activeTab == "recovery")
            {
                <section>
                    <div class="panel-head">
                        <h2>Emergency password reset</h2>
                        <span class="muted">Agentless Hyper-V recovery</span>
                    </div>

                    <div class="notice-card compact-notice">
                        <strong>No software inside the VPS required</strong>
                        <p>PenguinPanel uses a private per-VM recovery account over Hyper-V PowerShell Direct. It works through the Hyper-V VM bus, so the VM does not need working internet, RDP, WinRM, or PenguinGuestAgent.</p>
                    </div>

                    <div class="server-info-grid">
                        <div><span>Agentless recovery</span><strong>@AgentlessRecoveryStatusText()</strong></div>
                        @if (CanManageGuestAgent())
                        {
                            <div><span>Recovery account</span><strong>@ValueOrNotSet(recoveryAccountStatus.Username)</strong></div>
                        }
                        <div><span>Last rotated</span><strong>@RecoveryDateText(recoveryAccountStatus.LastRotatedAt)</strong></div>
                        <div><span>Last used</span><strong>@RecoveryDateText(recoveryAccountStatus.LastUsedAt)</strong></div>
                    </div>

                    @if (CanUseEmergencyGuestReset())
                    {
                        <div class="notice-card compact-notice">
                            <strong>Password recovery setup</strong>
                            <p>New VPSes are prepared automatically. If recovery is not ready, you can initialize or repair it while the saved Windows password still works. No Guest Agent or EXE is required.</p>
                            @if (CanManageGuestAgent() && !string.IsNullOrWhiteSpace(recoveryAccountStatus.LastError))
                            {
                                <p><strong>Last recovery error:</strong> @recoveryAccountStatus.LastError</p>
                            }
                            <div class="button-row settings-actions">
                                <button class="button primary" @onclick="InitializeAgentlessRecovery" disabled="@busy">Initialize / repair password recovery</button>
                            </div>
                        </div>
                    }

                    @if (!CanUseEmergencyGuestReset())
                    {
                        <div class="notice-card compact-notice">
                            <strong>Emergency reset locked</strong>
                            <p>Emergency password reset is only available to the account owner and administrators. Sub-users can still view access details if that permission is enabled.</p>
                        </div>
                    }
                    else if (!CanUseConfiguredEmergencyRecovery())
                    {
                        <div class="notice-card compact-notice">
                            <strong>Password recovery is not ready</strong>
                            <p>Password recovery is not initialized yet. Use <strong>Initialize / repair password recovery</strong> above while your currently saved Windows password still works.</p>
                        </div>
                    }
                    else
                    {
                        <div class="form-grid">
                            <label>Windows username<input @bind="emergencyUsername" disabled="@(busy || !CanManageGuestAgent())" /></label>
                            @if (!CanManageGuestAgent())
                            {
                                <div class="notice-card compact-notice full-row">
                                    <strong>Client password recovery</strong>
                                    <p>The reset uses your saved Windows/RDP username. The private PenguinPanel recovery account and its password are never shown to you.</p>
                                </div>
                            }

                            <label>New password<input type="@EmergencyPasswordInputType" @bind="emergencyPassword" autocomplete="new-password" disabled="@busy" /></label>
                            <label>Confirm password<input type="@EmergencyPasswordInputType" @bind="emergencyConfirmPassword" autocomplete="new-password" disabled="@busy" /></label>
                            <label>Reset verification code<input @bind="emergencyVerificationCode" inputmode="numeric" autocomplete="one-time-code" placeholder="6-digit email code" disabled="@busy" /></label>

                            <div class="notice-card compact-notice full-row">
                                <strong>Extra security step</strong>
                                <p>Send a one-time code to your panel account email before the reset. Agentless recovery then changes the Windows password through Hyper-V and rotates its private recovery password automatically.</p>
                                <div class="button-row settings-actions">
                                    <button class="button mini" @onclick="SendEmergencyResetCode" disabled="@(busy || !CanUseConfiguredEmergencyRecovery())">Email reset code</button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(emergencyPassword))
                            {
                                <div class="notice-card compact-notice full-row">
                                    <strong>Emergency password ready</strong>
                                    <p>Copy this password before resetting. It is cleared from the page after a successful reset or when the page reloads.</p>
                                    <div class="server-info-grid compact-secret-grid">
                                        <div><span>Username</span><strong>@ValueOrNotSet(emergencyUsername)</strong></div>
                                        <div><span>Password</span><strong>@EmergencyPasswordText()</strong></div>
                                    </div>
                                    <div class="button-row settings-actions">
                                        <button class="button mini" @onclick="ToggleEmergencyPasswordVisibility" disabled="@busy">@(showEmergencyPassword ? "Hide password" : "Show password")</button>
                                        <button class="button mini" @onclick='() => CopyToClipboard(emergencyPassword, "Emergency password")' disabled="@busy">Copy password</button>
                                    </div>
                                </div>
                            }

                            @if (CanManageGuestAgent())
                            {
                                <label class="check-row"><input type="checkbox" @bind="emergencyForceLogoffSessions" disabled="@busy" /> Sign out active RDP sessions after reset</label>
                                <label class="check-row"><input type="checkbox" @bind="emergencyRestartRemoteDesktopService" disabled="@busy" /> Restart Remote Desktop service after reset</label>
                            }

                            <label class="check-row"><input type="checkbox" @bind="emergencySendPasswordEmail" disabled="@busy" /> Email the new password to my panel account email</label>

                            <div class="form-actions full-row">
                                <button class="button" @onclick="GenerateEmergencyPassword" disabled="@busy">Generate emergency password</button>
                                <button class="button danger" @onclick="QueueEmergencyPasswordReset" disabled="@(busy || string.IsNullOrWhiteSpace(emergencyPassword) || (EmergencyResetCodeRequired && string.IsNullOrWhiteSpace(emergencyVerificationCode)) || !CanUseConfiguredEmergencyRecovery())">Reset Windows password</button>
                            </div>
                        </div>
                    }

                    @if (CanManageGuestAgent())
                    {
                        <div class="notice-card compact-notice">
                            <strong>Legacy Guest Agent - optional fallback</strong>
                            <p>The old PenguinGuestAgent integration is kept for existing VPSes and advanced legacy commands, but it is no longer required for normal emergency password recovery.</p>
                            <div class="server-info-grid">
                                <div><span>Agent</span><strong>@GuestAgentStatusText()</strong></div>
                                <div><span>Last seen</span><strong>@GuestAgentLastSeenText()</strong></div>
                                <div><span>Version</span><strong>@ValueOrNotSet(guestAgentSettings.LastAgentVersion)</strong></div>
                                <div><span>Last IP</span><strong>@ValueOrNotSet(guestAgentSettings.LastIpAddress)</strong></div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(generatedGuestAgentToken))
                            {
                                <p><strong>Copy this token now. It is only shown once:</strong></p>
                                <code>@generatedGuestAgentToken</code>
                                <div class="button-row settings-actions">
                                    <button class="button mini" @onclick='() => CopyToClipboard(generatedGuestAgentToken, "Guest Agent token")'>Copy token</button>
                                </div>
                            }
                            <div class="button-row settings-actions">
                                <button class="button" @onclick="GenerateGuestAgentToken" disabled="@busy">Generate / rotate legacy token</button>
                                <button class="button" @onclick='() => SetGuestAgentEnabled(true)' disabled="@(busy || !guestAgentSettings.HasToken)">Enable legacy agent</button>
                                <button class="button danger" @onclick='() => SetGuestAgentEnabled(false)' disabled="@busy">Disable legacy agent</button>
                            </div>
                        </div>
                    }

                    @if (CanManageGuestAgent() && guestAgentCommands.Count > 0)
                    {
                        <div class="table-wrap compact-table-wrap">
                            <table class="data-table compact-table">
                                <thead><tr><th>ID</th><th>Legacy command</th><th>Status</th><th>Created</th><th>Completed</th><th>Result</th></tr></thead>
                                <tbody>
                                    @foreach (var command in guestAgentCommands)
                                    {
                                        <tr>
                                            <td>@command.Id</td>
                                            <td>@command.CommandType</td>
                                            <td>@command.Status</td>
                                            <td>@command.CreatedAt.ToLocalTime()</td>
                                            <td>@(command.CompletedAt?.ToLocalTime().ToString() ?? "-")</td>
                                            <td>@ValueOrNotSet(command.ResultMessage)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
            else if (activeTab == "network")
            {
                <section>
                    <div class="panel-head">
                        <h2>Network</h2>
                        <span class="muted">Connection and protection actions</span>
                    </div>
                    <div class="notice-card">
                        <strong>Connection info</strong>
                        <p>RDP target: <strong>@RdpText()</strong>. Admins can scan outbound traffic using host resource metering and disconnect the VM network adapter if needed.</p>
                    </div>
                    @if (Session.User!.IsAdmin)
                    {
                        <div class="button-row big-actions">
                            <button class="button primary" @onclick="ScanNetwork" disabled="@busy">Scan outbound traffic</button>
                            <button class="button danger" @onclick='() => Run("disconnect")' disabled="@busy">Disconnect network</button>
                        </div>
                        <hr class="soft-line" />
                        <div class="panel-head sub-head">
                            <h2>Network / port profile</h2>
                            <span class="muted">Re-applied after template reinstall</span>
                        </div>
                        <div class="notice-card compact-notice">
                            <strong>Why this matters</strong>
                            <p>PenguinPanel keeps the same VM specs during reinstall. This profile makes sure the same internal IPv4, RDP port, FiveM TCP/UDP ports and extra NAT/firewall rules are saved and can be re-applied after the disk is replaced. Use the WinNAT object name from <code>Get-NetNat</code>, not the vEthernet adapter name.</p>
                        </div>
                        <div class="form-grid">
                            <label>NAT name<input @bind="profileNatName" placeholder="WinNAT name, e.g. HPanel-NAT — not vEthernet (HPanel-NAT)" /></label>
                            <label>Internal VM IPv4<input @bind="profileInternalIp" placeholder="192.168.119.100" /></label>
                            <label>Public IPv4<input @bind="profilePublicIp" placeholder="81.16.177.72" /></label>
                            <label>Public hostname<input @bind="profilePublicHostname" placeholder="example.penguinhosting.host" /></label>
                            <div class="notice-card full-row compact-notice">
                                <strong>Guest DNS / internet repair</strong>
                                <p>Guest DNS normally uses PenguinGuestAgent. If the VM has no internet and the agent cannot check in, use <strong>Repair guest internet</strong>. It uses Hyper-V PowerShell Direct from the host with the saved Access-tab Windows credentials, so it can fix IP/gateway/DNS even before the VM can reach the panel.</p>
                            </div>
                            <label>DNS interface alias<input @bind="profileDnsInterfaceAlias" placeholder="Auto, or e.g. Ethernet 2" /></label>
                            <div class="form-grid two-col-inline">
                                <label>Preferred DNS server<input @bind="profilePreferredDns" placeholder="81.16.177.72" /></label>
                                <label>Alternate DNS server<input @bind="profileAlternateDns" placeholder="1.1.1.1" /></label>
                            </div>
                            <label class="switch-row"><input type="checkbox" @bind="profileEnableRdp" /> Keep RDP NAT rule</label>
                            <div class="form-grid two-col-inline">
                                <label>RDP external port<input type="number" @bind="profileRdpExternalPort" /></label>
                                <label>Windows RDP / internal port<input type="number" @bind="profileRdpInternalPort" /></label>
                            </div>
                            <label class="switch-row"><input type="checkbox" @bind="profileEnableFiveM" /> Keep FiveM TCP/UDP rules</label>
                            <div class="form-grid two-col-inline">
                                <label>FiveM external port<input type="number" @bind="profileFiveMExternalPort" /></label>
                                <label>FiveM internal port<input type="number" @bind="profileFiveMInternalPort" /></label>
                            </div>
                            <label class="full-row">Extra TCP ports<textarea @bind="profileExtraTcpPorts" placeholder="One per line or comma-separated. Use external:internal, example: 40120:30120"></textarea></label>
                            <label class="full-row">Extra UDP ports<textarea @bind="profileExtraUdpPorts" placeholder="One per line or comma-separated. Example: 40120:30120"></textarea></label>
                            <div class="notice-card full-row compact-notice">
                                <strong>Current profile preview</strong>
                                <p>@NetworkProfilePreview()</p>
                            </div>
                            @if (portConflicts.Count > 0)
                            {
                                <div class="notice-card full-row compact-notice danger-note">
                                    <strong>Port conflict detected</strong>
                                    <ul>
                                        @foreach (var conflict in portConflicts)
                                        {
                                            <li>@conflict.Protocol/@conflict.ExternalPort is already used by @conflict.ConflictVmName</li>
                                        }
                                    </ul>
                                </div>
                            }
                            else if (portCheckCompleted)
                            {
                                <div class="notice-card full-row compact-notice success-note">No port conflicts found for this profile.</div>
                            }
                            <div class="form-actions full-row button-row">
                                <button class="button" @onclick="CopyNetworkProfileFromAccess" disabled="@busy">Copy from Access tab</button>
                                <button class="button" @onclick="CheckPortConflicts" disabled="@busy">Check conflicts</button>
                                <button class="button primary" @onclick="SaveNetworkProfile" disabled="@busy">Save network profile</button>
                                <button class="button" @onclick="ApplyGuestDnsSettings" disabled="@busy">Apply guest DNS now</button>
                                <button class="button" @onclick="RepairGuestInternet" disabled="@busy">Repair guest internet</button>
                                <button class="button primary soft" @onclick="ApplyNetworkProfile" disabled="@busy">Apply NAT/firewall + DNS now</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="muted">Network abuse tools are admin-only.</p>
                    }
                </section>
            }
            else if (activeTab == "firewall")
            {
                <section>
                    <div class="panel-head">
                        <h2>Windows Firewall</h2>
                        <span class="muted">Firewall rules inside this Windows VPS</span>
                    </div>

                    <div class="button-row big-actions">
                        <button class="button primary" @onclick="SyncGuestFirewall" disabled="@busy">Sync from network profile</button>
                        <button class="button" @onclick="LoadGuestFirewallRules" disabled="@busy">Refresh rules</button>
                    </div>

                    <hr class="soft-line" />
                    <div class="panel-head sub-head">
                        <h2>Add inbound rule</h2>
                        <span class="muted">PenguinPanel-managed rules only</span>
                    </div>
                    <div class="form-grid">
                        <label>Rule name<input @bind="firewallRuleName" placeholder="FiveM HTTP, game query, web panel..." /></label>
                        <label>Protocol
                            <select @bind="firewallProtocol">
                                <option value="TCP">TCP</option>
                                <option value="UDP">UDP</option>
                            </select>
                        </label>
                        <label>Local port<input type="number" min="1" max="65535" @bind="firewallLocalPort" /></label>
                        <label>Remote address<input @bind="firewallRemoteAddress" placeholder="Any, 203.0.113.20, or 203.0.113.0/24" /></label>
                        @if (Session.User!.IsAdmin)
                        {
                            <label>Action
                                <select @bind="firewallAction">
                                    <option value="Allow">Allow</option>
                                    <option value="Block">Block</option>
                                </select>
                            </label>
                        }
                        else
                        {
                            <label>Action<input value="Allow" disabled /></label>
                        }
                        <div class="form-actions full-row">
                            <button class="button primary" @onclick="AddGuestFirewallRule" disabled="@busy">Add Windows Firewall rule</button>
                        </div>
                    </div>

                    <hr class="soft-line" />
                    <div class="panel-head sub-head">
                        <h2>PenguinPanel firewall rules</h2>
                        <span class="muted">Automatic rules are rebuilt from the Network profile</span>
                    </div>
                    @if (!firewallRulesLoaded)
                    {
                        <p class="muted">Open this tab or press Refresh rules to read the Windows Firewall rules from the running VM.</p>
                    }
                    else if (guestFirewallRules.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <div class="empty-icon">▦</div>
                            <div>
                                <strong>No PenguinPanel Windows Firewall rules yet</strong>
                                <p class="muted">Use Sync from network profile to add RDP/FiveM rules, or create a custom inbound rule above.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <table class="data-table compact-table">
                            <thead><tr><th>Name</th><th>Protocol</th><th>Port</th><th>Remote</th><th>Action</th><th>Source</th><th>Actions</th></tr></thead>
                            <tbody>
                                @foreach (var rule in guestFirewallRules)
                                {
                                    <tr>
                                        <td><strong>@rule.DisplayName</strong></td>
                                        <td>@rule.Protocol</td>
                                        <td>@rule.LocalPort</td>
                                        <td>@rule.RemoteAddress</td>
                                        <td><span class="pill">@(rule.Enabled ? rule.Action : "Disabled")</span></td>
                                        <td>@(rule.IsAutomatic ? "Network profile" : "Custom")</td>
                                        <td>
                                            @if (rule.IsAutomatic)
                                            {
                                                <span class="muted">Change Network profile</span>
                                            }
                                            else
                                            {
                                                <button class="button mini danger" @onclick="() => RemoveGuestFirewallRule(rule)" disabled="@busy">Delete</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            }
            else if (activeTab == "backups")
            {
                <section>
                    <div class="panel-head">
                        <div>
                            <h2>Quick Restore Points</h2>
                            <span class="muted">Lightweight Hyper-V rollback points for updates, scripts, and configuration changes</span>
                        </div>
                        <button class="button" @onclick="LoadBackups" disabled="@(busy || restoreInProgress || fullBackupInProgress || fullRestoreInProgress)">Refresh</button>
                    </div>

                    <div class="notice-card snapshot-info-note">
                        <strong>Main rollback tool</strong>
                        <p>Quick Restore Points use Hyper-V checkpoints and normally consume storage only as the VM changes. PenguinPanel prefers a Production checkpoint for server workloads. They are not independent disaster-recovery backups, so keep <strong>Full Backups</strong> for the changes you really cannot afford to lose.</p>
                        <p class="snapshot-permanent-help"><strong>Permanent Restore Point:</strong> each VPS can protect exactly one normal restore point from age cleanup. Making a newer point permanent automatically returns the previous permanent point to normal retention.</p>
                    </div>

                    @if (quickSnapshotStorageStatus is not null)
                    {
                        <div class="snapshot-storage-grid">
                            <div>
                                <span>Restore points</span>
                                <strong>@quickSnapshotStorageStatus.ManualRestorePointCount / @quickSnapshotStorageStatus.MaxRestorePointsPerVm</strong>
                            </div>
                            <div>
                                <span>Temporary safety</span>
                                <strong>@quickSnapshotStorageStatus.TemporarySafetyCount</strong>
                            </div>
                            <div class="@(quickSnapshotStorageStatus.StorageWarning ? "snapshot-storage-warning" : "")">
                                <span>AVHDX storage</span>
                                <strong>@FormatBytes(quickSnapshotStorageStatus.TotalAvhdxBytes)</strong>
                            </div>
                            <div>
                                <span>Recommended age</span>
                                <strong>@quickSnapshotStorageStatus.RecommendedMaxAgeDays days</strong>
                            </div>
                        </div>

                        @if (quickSnapshotStorageStatus.StorageWarning)
                        {
                            <div class="notice-card compact-notice danger-note">
                                <strong>Snapshot storage is getting large</strong>
                                <p>The VM's Hyper-V AVHDX checkpoint chain is using about <strong>@FormatBytes(quickSnapshotStorageStatus.TotalAvhdxBytes)</strong>. Consider removing old unpinned restore points after confirming they are no longer needed.</p>
                            </div>
                        }
                    }

                    <div class="quick-restore-create">
                        <label>
                            <span>Restore point name</span>
                            <input @bind="checkpointName"
                                   maxlength="100"
                                   placeholder="Example: Before FiveM update" />
                        </label>
                        <label>
                            <span>Description <em>optional</em></span>
                            <input @bind="checkpointDescription"
                                   maxlength="500"
                                   placeholder="Example: Updating inventory + garage scripts" />
                        </label>
                        <button class="button primary"
                                @onclick="CreateCheckpoint"
                                disabled="@(busy || restoreInProgress || fullBackupInProgress || fullRestoreInProgress || (quickSnapshotStorageStatus is not null && quickSnapshotStorageStatus.ManualRestorePointCount >= quickSnapshotStorageStatus.MaxRestorePointsPerVm))">
                            Create restore point
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(checkpointError))
                    {
                        <div class="alert">Could not load Quick Restore Points: @checkpointError</div>
                    }

                    @if (quickRestorePoints.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <div class="empty-icon">↶</div>
                            <div>
                                <strong>No Quick Restore Points yet</strong>
                                <p class="muted">Create one before a risky update or configuration change.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table compact-table snapshot-table advanced-snapshot-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Kind</th>
                                        <th>Created</th>
                                        <th>Retention</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var point in quickRestorePoints)
                                    {
                                        <tr class="@(point.IsExpired ? "snapshot-expired-row" : "")">
                                            <td>
                                                <div class="snapshot-name-line">
                                                    <strong>@point.Name</strong>
                                                    @if (point.IsPinned)
                                                    {
                                                        <span class="pill snapshot-pin-pill">Permanent</span>
                                                    }
                                                    @if (point.IsTemporarySafety)
                                                    {
                                                        <span class="pill warning">Safety</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(point.Description))
                                                {
                                                    <div class="consistency-details">@point.Description</div>
                                                }
                                            </td>
                                            <td>
                                                <strong>@SnapshotTypeText(point)</strong>
                                                <div class="consistency-details">@point.SnapshotType</div>
                                            </td>
                                            <td>@point.CreationTime.ToLocalTime()</td>
                                            <td>
                                                @if (point.IsPinned)
                                                {
                                                    <span class="snapshot-retention-good">Permanent</span>
                                                }
                                                else if (point.IsExpired)
                                                {
                                                    <span class="snapshot-retention-expired">Expired</span>
                                                }
                                                else if (point.ExpiresAt is not null)
                                                {
                                                    <span>@SnapshotExpiryText(point)</span>
                                                }
                                                else
                                                {
                                                    <span>Managed</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="button-row snapshot-action-row">
                                                    <button class="button primary soft"
                                                            @onclick="() => RestoreCheckpoint(point)"
                                                            disabled="@(busy || restoreInProgress || fullBackupInProgress || fullRestoreInProgress)">
                                                        Restore
                                                    </button>
                                                    <button class="button"
                                                            @onclick="() => ToggleSnapshotPin(point)"
                                                            disabled="@(busy || restoreInProgress || fullBackupInProgress || fullRestoreInProgress || point.IsTemporarySafety)">
                                                        @(point.IsPinned ? "Remove permanent" : "Make permanent")
                                                    </button>
                                                    <button class="button danger"
                                                            @onclick="() => DeleteCheckpoint(point)"
                                                            disabled="@(busy || restoreInProgress || fullBackupInProgress || fullRestoreInProgress || point.IsPinned)">
                                                        Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (quickSnapshotStorageStatus?.ExpiredUnpinnedCount > 0)
                    {
                        <div class="snapshot-cleanup-bar">
                            <div>
                                <strong>@quickSnapshotStorageStatus.ExpiredUnpinnedCount expired unpinned restore point(s)</strong>
                                <p>Cleanup is explicit; PenguinPanel will never silently remove a pinned restore point.</p>
                            </div>
                            <button class="button danger"
                                    @onclick="CleanupExpiredSnapshots"
                                    disabled="@(busy || restoreInProgress || fullBackupInProgress || fullRestoreInProgress)">
                                Clean expired
                            </button>
                        </div>
                    }

                    @if (restoreInProgress || !string.IsNullOrWhiteSpace(restoreStatus))
                    {
                        <div class="restore-progress-card snapshot-restore-progress">
                            <div class="restore-progress-head">
                                <strong>@(restoreInProgress ? "Restoring Quick Restore Point" : "Last Quick Restore status")</strong>
                                <span>@restoreProgress%</span>
                            </div>
                            <div class="restore-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@restoreProgress">
                                <div class="restore-progress-bar" style="@($"width:{restoreProgress}%")"></div>
                            </div>
                            <p>@restoreStatus</p>
                        </div>
                    }

                    <hr class="backup-section-divider" />

                    <div class="panel-head">
                        <div>
                            <h2>Full Backups</h2>
                            <span class="muted">Independent disaster-recovery copies — larger and slower, but separate from the live VM disk chain</span>
                        </div>
                    </div>

                    <div class="notice-card backup-real-note">
                        <strong>These are real full-disk backups, not checkpoints</strong>
                        <p>PenguinPanel briefly stops the VM so the copied disk is consistent. If a Hyper-V checkpoint chain exists, PenguinPanel merges that chain into a standalone backup VHDX. The VM is started again automatically after a normal backup.</p>
                    </div>

                    @if (backupStorageStatus is not null)
                    {
                        <div class="backup-storage-strip smart-backup-summary">
                            <div><span>Smart storage</span><strong>@BackupStorageModeText(backupStorageStatus.SelectionMode)</strong></div>
                            <div><span>Current recommendation</span><strong>@backupStorageStatus.RootPath</strong></div>
                            <div><span>Free there</span><strong>@FormatBytes(backupStorageStatus.FreeBytes)</strong></div>
                            <div><span>Safety reserve</span><strong>@FormatBytes(backupStorageStatus.ReserveBytes)</strong></div>
                            <div><span>Manual limit</span><strong>@backupStorageStatus.MaxBackupsPerVm per VPS</strong></div>
                        </div>

                        <div class="backup-root-candidates">
                            @foreach (var rootStatus in backupStorageStatus.Roots)
                            {
                                <div class="backup-root-candidate @(rootStatus.IsAvailable ? "" : "backup-root-unavailable")">
                                    <div>
                                        <strong>@rootStatus.Path</strong>
                                        @if (string.Equals(rootStatus.Path, backupStorageStatus.RootPath, StringComparison.OrdinalIgnoreCase) && backupStorageStatus.IsAvailable)
                                        {
                                            <span class="pill online">Recommended</span>
                                        }
                                        else if (rootStatus.IsDefault)
                                        {
                                            <span class="pill">Default</span>
                                        }
                                    </div>
                                    @if (rootStatus.IsAvailable)
                                    {
                                        <span>@FormatBytes(rootStatus.FreeBytes) free · keep @FormatBytes(rootStatus.ReserveBytes) reserve</span>
                                    }
                                    else
                                    {
                                        <span>@rootStatus.Error</span>
                                    }
                                </div>
                            }
                        </div>

                        @if (!backupStorageStatus.IsAvailable)
                        {
                            <div class="alert">Backup storage unavailable: @backupStorageStatus.Error</div>
                        }
                        else
                        {
                            <div class="backup-name-help smart-backup-note">
                                The recommendation above is based on current free space. When you actually create a Full Backup, PenguinPanel estimates that VM's backup size and re-selects the safest root while keeping the reserve.
                            </div>
                        }
                    }

                    @if (fullBackupInProgress || !string.IsNullOrWhiteSpace(fullBackupStatus))
                    {
                        <div class="restore-progress-card">
                            <div class="restore-progress-head">
                                <strong>@(fullBackupInProgress ? "Creating full backup" : "Last backup status")</strong>
                                <span>@fullBackupProgress%</span>
                            </div>
                            <div class="restore-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@fullBackupProgress">
                                <div class="restore-progress-bar" style="@($"width:{fullBackupProgress}%")"></div>
                            </div>
                            <p>@fullBackupStatus</p>
                        </div>
                    }

                    @if (fullRestoreInProgress || !string.IsNullOrWhiteSpace(fullRestoreStatus))
                    {
                        <div class="restore-progress-card restore-full-card">
                            <div class="restore-progress-head">
                                <strong>@(fullRestoreInProgress ? "Restoring full backup" : "Last full restore status")</strong>
                                <span>@fullRestoreProgress%</span>
                            </div>
                            <div class="restore-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@fullRestoreProgress">
                                <div class="restore-progress-bar" style="@($"width:{fullRestoreProgress}%")"></div>
                            </div>
                            <p>@fullRestoreStatus</p>
                        </div>
                    }

                    <div class="backup-name-form">
                        <label>
                            <span>Backup name</span>
                            <input @bind="fullBackupName"
                                   maxlength="120"
                                   placeholder="Example: Before FiveM update" />
                        </label>
                        <div class="backup-name-help">
                            Give important backups a name you will recognize later. If left blank, PenguinPanel creates a dated name automatically.
                        </div>
                        <button class="button primary"
                                @onclick="CreateFullBackup"
                                disabled="@(busy || fullBackupInProgress || fullRestoreInProgress || backupStorageStatus?.IsAvailable == false)">
                            Create full backup
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(fullBackupError))
                    {
                        <div class="alert">Could not load full backups: @fullBackupError</div>
                    }

                    @if (fullBackups.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <div class="empty-icon">▣</div>
                            <div>
                                <strong>No full backups yet</strong>
                                <p class="muted">Create one before major updates, reinstall work, or risky server changes.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table compact-table backup-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Status</th>
                                        <th>Size</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var backup in fullBackups)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@backup.Name</strong>
                                                @if (!string.IsNullOrWhiteSpace(backup.LastError))
                                                {
                                                    <div class="consistency-details">@backup.LastError</div>
                                                }
                                            </td>
                                            <td>@BackupTypeText(backup.BackupType)</td>
                                            <td><span class="pill @BackupStatusClass(backup.Status)">@BackupStatusText(backup.Status)</span></td>
                                            <td>@FormatBytes(backup.TotalBytes)</td>
                                            <td>@backup.CreatedAt.ToLocalTime()</td>
                                            <td class="button-row">
                                                @if (backup.Status.Equals("complete", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button class="button primary soft"
                                                            @onclick="() => BeginFullRestore(backup)"
                                                            disabled="@(busy || fullBackupInProgress || fullRestoreInProgress)">
                                                        Restore
                                                    </button>
                                                }
                                                <button class="button danger"
                                                        @onclick="() => DeleteFullBackup(backup)"
                                                        disabled="@(busy || fullBackupInProgress || fullRestoreInProgress || backup.Status.Equals("creating", StringComparison.OrdinalIgnoreCase))">
                                                    Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
