                message = rdpListenerStatus.IsReady
                    ? rdpListenerStatus.IsUdpReady
                        ? $"Windows RDP, guest firewall, and WinNAT are now aligned on TCP + UDP {rdpListenerStatus.Port}. Public endpoint: {RdpText()}."
                        : $"RDP TCP {rdpListenerStatus.Port} is aligned and usable, but Windows did not report a UDP listener. TCP fallback remains available; run Health → Repair and verify again."
                    : $"The RDP port was updated to {rdpListenerStatus.Port}, but the TCP listener did not report ready yet. Reboot the VPS once and verify again.";
                lastAction = message;
            });
        }
        finally
        {
            rdpListenerChanging = false;
        }
    }

