    private async Task CreateTemplateFromCurrentVm()
    {
        if (vm is null) return;

        var name = string.IsNullOrWhiteSpace(templateName) ? $"{vm.Name} template" : templateName.Trim();
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Create template '{name}' from {vm.Name}?\n\nThe VM will be temporarily stopped while its primary virtual disk is copied. This can take a while depending on disk size.");

        if (!confirmed)
        {
            return;
        }

        busy = true;
        templateStatus = $"Stopping {vm.Name} if needed and copying the primary disk to the template folder...";
        message = null;
        messageClass = "alert success";
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await Panel.CreateTemplateFromVmAsync(Session.User, vm.Name, name, templateOs, templateStorageFolder, templateNotes, templateEnabled);
            templateStatus = result.Message;
            message = $"Template created: {result.TemplatePath}";
            lastAction = message;
            templateName = "";
            templateIsoPath = "";
            templateNotes = "";
            templateOs = "Windows";
            templateEnabled = true;
            await Load();
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
            lastAction = ex.Message;
            templateStatus = "Template creation failed: " + ex.Message;
        }
        finally
        {
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

