    private async Task QueueEmergencyPasswordReset()
    {
        if (vm is null) return;
        await RunPanelAction(async () =>
        {
            if (emergencyPassword != emergencyConfirmPassword)
            {
                throw new InvalidOperationException("The emergency passwords do not match.");
            }

            var resetUsername = CanManageGuestAgent()
                ? (string.IsNullOrWhiteSpace(emergencyUsername) ? access.Username : emergencyUsername)
                : (string.IsNullOrWhiteSpace(access.Username) ? "Administrator" : access.Username);

            var result = await Panel.QueueEmergencyGuestPasswordResetAsync(
                Session.User,
                vm.Name,
                resetUsername,
                emergencyPassword,
                emergencyVerificationCode,
                emergencySendPasswordEmail,
                CanManageGuestAgent() ? emergencyForceLogoffSessions : true,
                CanManageGuestAgent() ? emergencyRestartRemoteDesktopService : true,
                CanManageGuestAgent() && emergencyDisableOtherLocalAdministrators,
                CanManageGuestAgent() && emergencyDisableRemoteDesktopFirewall);

            message = result.Message;
            emergencyVerificationCode = "";
            if (!emergencySendPasswordEmail || result.PasswordEmailSent)
            {
                emergencyPassword = "";
                emergencyConfirmPassword = "";
                showEmergencyPassword = false;
            }
            else
            {
                showEmergencyPassword = true;
            }
            guestAgentSettings = await Panel.GetVmGuestAgentSettingsAsync(Session.User, vm.Name);
            guestAgentCommands = CanManageGuestAgent()
                ? await Panel.GetGuestAgentCommandsForVmAsync(Session.User, vm.Name)
                : [];
            await Load(false);
        });
    }

