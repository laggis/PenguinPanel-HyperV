    private async Task ConfirmRestorePreviousOs()
    {
        if (vm is null
            || reinstallRollback is null
            || reinstallRollbackInProgress)
        {
            return;
        }

        var rollbackId = reinstallRollback.Id;
        reinstallRollbackPendingAction = string.Empty;
        reinstallRollbackInProgress = true;
        reinstallRollbackProgress = 2;
        reinstallRollbackStatus = "Preparing previous OS restore...";
        busy = true;
        message = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await Panel.RestoreReinstallRollbackAsync(
                Session.User,
                vm.Name,
                rollbackId,
                async (percent, status) =>
                {
                    await InvokeAsync(() =>
                    {
                        reinstallRollbackProgress = percent;
                        reinstallRollbackStatus = status;
                        StateHasChanged();
                    });
                });

            messageClass = result.Warnings.Count == 0
                ? "alert success"
                : "alert";
            message = result.Message;
            lastAction = result.Message;
            reinstallRollbackProgress = 100;
            reinstallRollbackStatus = "Previous OS restored.";
            reinstallDataLoaded = false;
            await Load(false);
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
            lastAction = ex.Message;
            reinstallRollbackProgress = 100;
            reinstallRollbackStatus = "Previous OS restore stopped: " + ex.Message;
        }
        finally
        {
            reinstallRollbackInProgress = false;
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

