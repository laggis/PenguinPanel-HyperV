        if (vm is null) return;
        rdpListenerChanging = true;
        try
        {
            await RunPanelAction(async () =>
            {
                rdpListenerStatus = await Panel.SyncVmWindowsRdpPortToPublicAsync(Session.User, vm.Name);
                networkProfile = await Panel.GetVmNetworkPortProfileAsync(Session.User, vm.Name);
                CopyNetworkProfileToEditFields();
                access = await Panel.GetVmAccessInfoAsync(Session.User, vm.Name);
                CopyAccessToEditFields();
                messageClass = rdpListenerStatus.IsReady ? "alert success" : "alert";
                message = rdpListenerStatus.IsReady
                    ? $"Windows RDP, guest firewall, and WinNAT are now aligned on TCP {rdpListenerStatus.Port}. Public endpoint: {RdpText()}."
                    : $"The RDP port was updated to TCP {rdpListenerStatus.Port}, but the listener did not report ready yet. Reboot the VPS once and verify again.";
                lastAction = message;
            });
        }
        finally
        {
            rdpListenerChanging = false;
        }
    }

    private string RdpNatTargetText()
    {
        var internalIp = !string.IsNullOrWhiteSpace(networkProfile.InternalIpAddress)
            ? networkProfile.InternalIpAddress
            : profileInternalIp;
        var internalPort = networkProfile.RdpInternalPort > 0 ? networkProfile.RdpInternalPort : 3389;
        return string.IsNullOrWhiteSpace(internalIp) ? $"Internal TCP {internalPort}" : $"{internalIp}:{internalPort}";
    }

    private string RdpListenerText()
    {
        if (rdpListenerStatus is null)
        {
            return "Not verified yet";
        }

        var status = rdpListenerStatus.IsReady ? "ready" : "not ready";
        return $"TCP {rdpListenerStatus.Port} ({status}, checked {rdpListenerStatus.CheckedAt.ToLocalTime():HH:mm:ss})";
    }

