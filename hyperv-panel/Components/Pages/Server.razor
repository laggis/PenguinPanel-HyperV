    private bool CanRunPowerAction(string action)
    {
        if (vm is null || busy || restoreInProgress || reinstallInProgress || !CanUsePowerActions())
        {
            return false;
        }

        return action switch
        {
            "start" => IsStoppedState(vm.State) || IsPausedState(vm.State),
            "restart" => IsRunningState(vm.State),
            "stop" => IsRunningState(vm.State) || IsPausedState(vm.State),
            "suspend" => IsRunningState(vm.State),
            "resume" => IsPausedState(vm.State),
            _ => false
        };
    }

    private string PowerActionTitle(string action)
    {
        if (restoreInProgress) return "A checkpoint restore is in progress.";
        if (reinstallInProgress) return "A reinstall is in progress.";
        if (busy) return "Another action is already running.";
        if (!CanUsePowerActions()) return "Power controls are disabled for your account.";

        return action switch
        {
            "start" when !CanRunPowerAction(action) => "The VM is already running, so Start is disabled.",
            "restart" when !CanRunPowerAction(action) => "Restart is only available while the VM is running.",
            "stop" when !CanRunPowerAction(action) => "Stop is only available while the VM is running or paused.",
            "suspend" when !CanRunPowerAction(action) => "Pause is only available while the VM is running.",
            "resume" when !CanRunPowerAction(action) => "Resume is only available while the VM is paused or saved.",
            _ => string.Empty
        };
    }

