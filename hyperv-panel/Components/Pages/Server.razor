    private async Task Run(string action)
    {
        if (vm is null || !CanUsePowerActions()) return;

        if (IsPowerButtonAction(action))
        {
            await RunPowerAction(action);
            return;
        }

        await RunPanelAction(async () =>
        {
            await Panel.VmActionAsync(Session.User, action, vm.Name);
            message = $"{ActionName(action)} sent to {vm.Name}.";
            lastAction = message;
            await Load(false);
        });
    }

    private async Task RunPowerAction(string action)
    {
        if (vm is null || !CanRunPowerAction(action)) return;

        busy = true;
        powerInProgress = true;
        powerAction = action;
        powerProgress = 8;
        powerStatus = $"Preparing to {ActionVerb(action)} {vm.Name}...";
        message = null;
        messageClass = "alert success";
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(150);
            powerProgress = 28;
            powerStatus = $"Sending {ActionName(action).ToLowerInvariant()} command to Hyper-V...";
            await InvokeAsync(StateHasChanged);

            await Panel.VmActionAsync(Session.User, action, vm.Name);

            powerProgress = 68;
            powerStatus = "Command accepted. Refreshing server state...";
            await InvokeAsync(StateHasChanged);

            await Load(false);

            powerProgress = 100;
            powerStatus = $"{ActionName(action)} completed.";
            message = $"{ActionName(action)} sent to {vm?.Name ?? VmName}.";
            lastAction = message;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(700);
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
            lastAction = ex.Message;
            powerStatus = $"{ActionName(action)} failed: {ex.Message}";
            powerProgress = 100;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1200);
        }
        finally
        {
            powerInProgress = false;
            powerAction = string.Empty;
            powerProgress = 0;
            powerStatus = string.Empty;
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

