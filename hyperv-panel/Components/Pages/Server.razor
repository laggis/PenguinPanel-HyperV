    private void StartLiveMonitoringPolling()
    {
        if (liveMonitoringPollCts is not null || activeTab != "monitoring" || vm is null) return;
        liveMonitoringPollCts = new CancellationTokenSource();
        _ = PollLiveMonitoringAsync(liveMonitoringPollCts.Token);
    }

    private async Task PollLiveMonitoringAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                var seconds = Math.Clamp(Configuration.GetValue("Monitoring:UiRefreshSeconds", 5), 3, 60);
                await Task.Delay(TimeSpan.FromSeconds(seconds), cancellationToken);
                await InvokeAsync(async () =>
                {
                    if (activeTab != "monitoring") return;
                    await LoadLiveMonitoringAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void StopLiveMonitoringPolling()
    {
        var cts = liveMonitoringPollCts;
        liveMonitoringPollCts = null;
        if (cts is null) return;
        cts.Cancel();
        cts.Dispose();
    }

