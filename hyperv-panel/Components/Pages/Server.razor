        if (HasWebConsoleUrl()) return IsGuacamoleProvider() ? "Guacamole configured" : "Per-VM URL configured";
        if (WebRdpEnabled() && !string.IsNullOrWhiteSpace(WebRdpBaseUrl()))
        {
            return IsGuacamoleProvider() ? "Using global Guacamole" : "Using global web RDP";
