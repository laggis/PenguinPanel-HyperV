    private static string RollbackExpiryText(
        VmReinstallRollbackInfo rollback)
    {
        var remaining = rollback.ExpiresAt - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return "Expired";
        }

        if (remaining.TotalDays >= 1)
        {
            return remaining.TotalDays < 2
                ? $"{remaining.TotalHours:0} hours remaining"
                : $"{remaining.TotalDays:0.0} days remaining";
        }

        if (remaining.TotalHours >= 1)
        {
            return $"{remaining.TotalHours:0} hours remaining";
        }

        return $"{Math.Max(1, remaining.TotalMinutes):0} minutes remaining";
    }

    private bool ReinstallPasswordReady()
    {
        var password = reinstallWindowsPassword ?? string.Empty;
        var confirmation = reinstallWindowsPasswordConfirm ?? string.Empty;

        if (string.IsNullOrWhiteSpace(password)
            && string.IsNullOrWhiteSpace(confirmation))
        {
            return true;
        }

        return password.Length >= 8
            && string.Equals(
                password,
                confirmation,
                StringComparison.Ordinal);
    }

    private async Task RunDirectReinstallNow()
    {
        if (vm is null
            || selectedTemplateId == 0
            || reinstallInProgress
            || reinstallConfirmPending)
        {
            return;
        }

        var clientPasswordBlank =
            string.IsNullOrWhiteSpace(reinstallWindowsPassword)
            && string.IsNullOrWhiteSpace(reinstallWindowsPasswordConfirm);

        if (!clientPasswordBlank
            && (string.IsNullOrWhiteSpace(reinstallWindowsPassword)
                || reinstallWindowsPassword.Length < 8))
        {
            messageClass = "alert";
            message = "Use at least 8 characters for the Windows / RDP password, or leave both password fields blank and PenguinPanel will generate one automatically.";
            return;
        }

        if (!clientPasswordBlank
            && !string.Equals(
                reinstallWindowsPassword,
                reinstallWindowsPasswordConfirm,
                StringComparison.Ordinal))
        {
            messageClass = "alert";
            message = "The Windows / RDP passwords do not match. Leave both fields blank if you want PenguinPanel to generate a temporary password instead.";
            return;
        }

        var templateNameForConfirm =
            templates.FirstOrDefault(t => t.Id == selectedTemplateId)?.Name
            ?? "the selected operating system";

        VmReinstallPreflight preflight;
        try
        {
            preflight = await Panel.GetReinstallPreflightAsync(
                Session.User,
                vm.Name,
                selectedTemplateId);
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = "PenguinPanel could not prepare the reinstall: " + ex.Message;
            return;
        }

        if (!preflight.CanProceed)
        {
            messageClass = "alert";
            message =
                "This server cannot be reinstalled safely yet. "
                + preflight.Summary
                + " "
                + string.Join(" ", preflight.Warnings);
            return;
        }

        // Freeze the exact values being reviewed. The customer only sees a simple
        // destructive-action warning; the technical preflight stays internal.
        pendingReinstallTemplateId = selectedTemplateId;
        pendingReinstallTemplateName = templateNameForConfirm;
        pendingReinstallWindowsPassword = reinstallWindowsPassword;
        pendingReinstallPasswordWillBeGenerated = clientPasswordBlank;
        reinstallConfirmPending = true;

        // Do not leave a chosen password visible in the browser form while the
        // confirmation card is open. It remains only in component memory.
        reinstallWindowsPassword = string.Empty;
        reinstallWindowsPasswordConfirm = string.Empty;

        message = null;
        await InvokeAsync(StateHasChanged);
    }

    private bool HasValidPendingReinstallConfirmation() =>
        reinstallConfirmPending
        && pendingReinstallTemplateId > 0
        && !string.IsNullOrWhiteSpace(pendingReinstallTemplateName);

    private async Task ConfirmPendingReinstall()
    {
        if (vm is null
            || !HasValidPendingReinstallConfirmation()
            || reinstallInProgress)
        {
            return;
        }

        var templateId = pendingReinstallTemplateId;
        var templateNameForReinstall = pendingReinstallTemplateName;
        var requestedWindowsPassword = pendingReinstallWindowsPassword;

        ClearPendingReinstallConfirmation();
        await InvokeAsync(StateHasChanged);

        await RunReinstallWithProgress(
            templateId,
            templateNameForReinstall,
            requestedWindowsPassword);
    }

