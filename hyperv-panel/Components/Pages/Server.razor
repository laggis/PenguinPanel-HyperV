    private async Task VerifyRdpListener()
    {
        if (vm is null) return;
        rdpListenerChecking = true;
        try
        {
            await RunPanelAction(async () =>
            {
                rdpListenerStatus = await Panel.GetVmRdpListenerStatusAsync(Session.User, vm.Name);
                var expected = networkProfile.RdpInternalPort <= 0 ? 3389 : networkProfile.RdpInternalPort;
                messageClass = rdpListenerStatus.IsReady && rdpListenerStatus.IsUdpReady && rdpListenerStatus.Port == expected ? "alert success" : "alert";
                message = rdpListenerStatus.IsReady
                    ? rdpListenerStatus.Port == expected
                        ? rdpListenerStatus.IsUdpReady
                            ? $"Windows RDP is listening correctly on TCP + UDP {rdpListenerStatus.Port}."
                            : $"Windows RDP TCP {rdpListenerStatus.Port} is ready, but UDP is not listening. TCP fallback still works; use Health → Repair to restore the UDP path."
                        : $"Windows RDP is listening on port {rdpListenerStatus.Port}, but PenguinPanel WinNAT expects internal port {expected}. Use Match Windows RDP to public port, or update the Network profile."
                    : $"Windows RDP check completed on port {rdpListenerStatus.Port}, but one or more required TCP components are not ready.";
                lastAction = message;
            });
        }
        finally
        {
            rdpListenerChecking = false;
        }
    }

    private async Task SyncRdpPortToPublic()
    {
        if (vm is null) return;
        rdpListenerChanging = true;
        try
