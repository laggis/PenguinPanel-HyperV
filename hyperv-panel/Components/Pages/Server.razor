    private bool ShouldRunHyperVConsole()
    {
        return UseHyperVBasicConsole()
            && activeTab == "console"
            && vm is not null
            && IsConsoleAvailableState(vm.State)
            && Session.User?.EffectivePermissions.CanViewConsole == true;
    }

    private void StartHyperVConsolePolling()
    {
        if (!ShouldRunHyperVConsole() || hyperVConsolePollCts is not null)
        {
            return;
        }

        var cts = new CancellationTokenSource();
        hyperVConsolePollCts = cts;
        _ = PollHyperVConsoleAsync(cts);
    }

    private void StopHyperVConsolePolling()
    {
        var cts = hyperVConsolePollCts;
        hyperVConsolePollCts = null;
        if (cts is null)
        {
            return;
        }

        try
        {
            cts.Cancel();
        }
        catch
        {
        }

        cts.Dispose();
    }

    private async Task PollHyperVConsoleAsync(CancellationTokenSource owner)
    {
        var refreshMs = Math.Clamp(
            Configuration.GetValue("Console:HyperV:RefreshMs", 350),
            200,
            5000);

        try
        {
            while (!owner.IsCancellationRequested && ShouldRunHyperVConsole())
            {
                var cycleStarted = System.Diagnostics.Stopwatch.GetTimestamp();
                await CaptureHyperVConsoleFrameAsync(showErrors: hyperVConsoleFrame is null);

                var elapsed = System.Diagnostics.Stopwatch.GetElapsedTime(cycleStarted);
                var remainingMs = Math.Max(10, refreshMs - (int)Math.Ceiling(elapsed.TotalMilliseconds));

                try
                {
                    await Task.Delay(remainingMs, owner.Token);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
            }
        }
        finally
        {
            if (ReferenceEquals(hyperVConsolePollCts, owner))
            {
                hyperVConsolePollCts = null;
                owner.Dispose();
            }
        }
    }

    private async Task CaptureHyperVConsoleFrameAsync(bool showErrors)
    {
        if (vm is null || !ShouldRunHyperVConsole() || hyperVConsoleBusy)
        {
            return;
        }

        hyperVConsoleBusy = true;
        try
        {
            var frame = await Panel.GetVmConsoleFrameAsync(Session.User, vm.Name);
            hyperVConsoleFrame = frame;
            hyperVConsoleError = string.Empty;
        }
        catch (Exception ex)
        {
            if (showErrors || hyperVConsoleFrame is null)
            {
                hyperVConsoleError = ex.Message;
            }
        }
        finally
        {
            hyperVConsoleBusy = false;
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
            }
        }
    }

