            var result = await Panel.QueueEmergencyGuestPasswordResetAsync(
                Session.User,
                vm.Name,
                resetUsername,
                emergencyPassword,
                emergencyVerificationCode,
                emergencySendPasswordEmail,
                CanManageGuestAgent() ? emergencyForceLogoffSessions : true,
                CanManageGuestAgent() ? emergencyRestartRemoteDesktopService : true,
                false,
                false);

            message = result.Message;
            emergencyVerificationCode = "";
            if (!emergencySendPasswordEmail || result.PasswordEmailSent)
            {
                emergencyPassword = "";
                emergencyConfirmPassword = "";
                showEmergencyPassword = false;
            }
            else
            {
                showEmergencyPassword = true;
            }
            recoveryAccountStatus = await Panel.GetVmRecoveryAccountStatusAsync(Session.User, vm.Name);
            guestAgentSettings = await Panel.GetVmGuestAgentSettingsAsync(Session.User, vm.Name);
            guestAgentCommands = CanManageGuestAgent()
