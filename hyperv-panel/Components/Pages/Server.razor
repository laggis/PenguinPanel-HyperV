    private static bool IsConsoleAvailableState(string? state)
    {
        if (string.IsNullOrWhiteSpace(state)) return false;
        return state.Equals("2", StringComparison.OrdinalIgnoreCase)
            || state.Equals("Running", StringComparison.OrdinalIgnoreCase)
            || state.Contains("Running", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsRunningState(string? state)
    {
        if (string.IsNullOrWhiteSpace(state)) return false;
        return state.Contains("Running", StringComparison.OrdinalIgnoreCase)
            || state.Contains("Starting", StringComparison.OrdinalIgnoreCase)
            || state.Contains("Resuming", StringComparison.OrdinalIgnoreCase)
            || state == "2";
    }

    private static bool IsStoppedState(string? state)
    {
        if (string.IsNullOrWhiteSpace(state)) return false;
        return state.Contains("Off", StringComparison.OrdinalIgnoreCase)
            || state.Contains("Stopped", StringComparison.OrdinalIgnoreCase)
            || state == "3";
    }

    private static bool IsPausedState(string? state)
    {
        if (string.IsNullOrWhiteSpace(state)) return false;
        return state.Contains("Paused", StringComparison.OrdinalIgnoreCase)
            || state.Contains("Saved", StringComparison.OrdinalIgnoreCase)
            || state.Contains("Suspended", StringComparison.OrdinalIgnoreCase);
    }

    private int HealthCount(string status)
    {
        return healthReport?.Checks.Count(item => string.Equals(item.Status, status, StringComparison.OrdinalIgnoreCase)) ?? 0;
    }

    private string HealthSummaryText()
    {
        if (healthReport is null) return "No health report loaded.";

        var critical = HealthCount("critical");
        var warnings = HealthCount("warning");
        if (critical > 0) return $"{critical} critical problem(s) and {warnings} warning(s) need attention.";
        if (warnings > 0) return $"No critical failures. {warnings} warning(s) should be reviewed.";
        return "All checked PenguinPanel-managed components are healthy.";
    }

    private static string HealthStatusText(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => "Healthy",
        "warning" => "Warning",
        "critical" => "Critical",
        "skipped" => "Skipped",
        _ => status
    };

    private static string HealthPillClass(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => "online",
        "critical" => "offline",
        "warning" => "warning",
        _ => string.Empty
    };

    private static string HealthNoticeClass(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => "success-note",
        "critical" => "danger-note",
        _ => string.Empty
    };

    private static string StateClass(string state)
    {
        if (state.Contains("Running", StringComparison.OrdinalIgnoreCase) || state == "2") return "online";
        if (state.Contains("Off", StringComparison.OrdinalIgnoreCase) || state.Contains("Stopped", StringComparison.OrdinalIgnoreCase) || state == "3") return "offline";
        return "warning";
    }

    private static string PrettyState(string state) => state switch
    {
        "2" => "Running",
        "3" => "Off",
        "32768" => "Paused",
        "32769" => "Suspended",
        _ => state
    };

    private static int Clamp(int value) => Math.Max(0, Math.Min(100, value));

    private static string FormatUptime(TimeSpan value) => value == TimeSpan.Zero ? "-" : $"{(int)value.TotalDays}d {value.Hours}h {value.Minutes}m";

    private static string FormatRate(double bytesPerSecond) => $"{FormatBytes((long)Math.Max(0, bytesPerSecond))}/s";

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var value = (double)bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {units[unit]}";
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (Session.IsLoggedIn && !string.IsNullOrWhiteSpace(VmName))
            {
                await Load();
            }
            else
            {
                StopLiveMonitoringPolling();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        StopLiveMonitoringPolling();
        StopHyperVConsolePolling();
        hyperVConsoleDotNetRef?.Dispose();
        hyperVConsoleDotNetRef = null;
    }
}
