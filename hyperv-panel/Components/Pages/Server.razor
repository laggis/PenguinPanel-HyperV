    private void BeginFullRestore(VmFullBackupInfo backup)
    {
        if (fullRestoreInProgress || fullBackupInProgress) return;
        pendingFullRestoreBackup = backup;
        fullRestoreConfirmation = string.Empty;
        fullRestoreStatus = string.Empty;
        fullRestoreProgress = 0;
