    private async Task OpenTab(string tab)
    {
        if (!CanViewTab(tab))
        {
            return;
        }

        activeTab = tab;
        if (!string.Equals(tab, "console", StringComparison.OrdinalIgnoreCase))
        {
            StopHyperVConsolePolling();
        }
        if (!string.Equals(tab, "monitoring", StringComparison.OrdinalIgnoreCase))
        {
            StopLiveMonitoringPolling();
        }
        var needsRemoteLoad = TabNeedsLazyLoad(tab);
        if (needsRemoteLoad)
        {
            tabLoading = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            await LoadActiveTabDataAsync(force: false);
            if (string.Equals(tab, "monitoring", StringComparison.OrdinalIgnoreCase))
            {
                StartLiveMonitoringPolling();
            }
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
        }
        finally
        {
            if (needsRemoteLoad)
            {
                tabLoading = false;
            }
        }
    }

    private bool TabNeedsLazyLoad(string tab) => tab switch
    {
        "recovery" => !recoveryDataLoaded,
        "monitoring" => liveMonitoring is null,
        "health" => Session.User?.IsAdmin == true && !healthDataLoaded,
        "backups" => !backupsDataLoaded,
        "reinstall" => !reinstallDataLoaded,
        "activity" => !activityDataLoaded,
        "settings" => Session.User?.IsAdmin == true && !settingsDataLoaded,
        _ => false
    };

    private async Task LoadActiveTabDataAsync(bool force)
    {
        if (vm is null)
        {
            return;
        }

        switch (activeTab)
        {
            case "monitoring" when CanViewTab("monitoring") && (force || liveMonitoring is null):
                await LoadLiveMonitoringAsync();
                StartLiveMonitoringPolling();
                break;

            case "health" when Session.User?.IsAdmin == true && CanViewTab("health") && (force || !healthDataLoaded):
                healthReport = await Panel.GetVmHealthReportAsync(Session.User, vm.Name);
                healthRepairResult = null;
                healthDataLoaded = true;
                break;

            case "recovery" when CanViewTab("recovery") && (force || !recoveryDataLoaded):
                recoveryAccountStatus = await Panel.GetVmRecoveryAccountStatusAsync(Session.User, vm.Name);
                guestAgentSettings = await Panel.GetVmGuestAgentSettingsAsync(Session.User, vm.Name);
                guestAgentCommands = CanManageGuestAgent()
                    ? await Panel.GetGuestAgentCommandsForVmAsync(Session.User, vm.Name)
                    : [];
                if (string.IsNullOrWhiteSpace(emergencyUsername) || !CanManageGuestAgent())
                {
                    emergencyUsername = string.IsNullOrWhiteSpace(access.Username) ? "Administrator" : access.Username;
                }
                recoveryDataLoaded = true;
                break;

            case "backups" when CanViewTab("backups") && (force || !backupsDataLoaded):
                await LoadBackups();
                backupsDataLoaded = true;
                break;

            case "reinstall" when CanViewTab("reinstall") && (force || !reinstallDataLoaded):
                templates = await Panel.GetVmTemplatesAsync(Session.User);
                reinstallRequests = await Panel.GetReinstallRequestsAsync(Session.User, vm.Name);
                reinstallRollback = await Panel.GetReinstallRollbackAsync(Session.User, vm.Name);
                reinstallDataLoaded = true;
                break;

            case "activity" when CanViewTab("activity") && (force || !activityDataLoaded):
                auditLogs = await Panel.GetAuditLogsForVmAsync(Session.User, vm.Name);
                activityDataLoaded = true;
                break;

            case "settings" when Session.User?.IsAdmin == true && (force || !settingsDataLoaded):
                publicStatusSettings = await Panel.GetVmPublicStatusSettingsAsync(Session.User, vm.Name);
                CopyPublicStatusToEditFields();
                settingsDataLoaded = true;
                break;
        }
    }

