        if (showPageLoading)
        {
            loading = true;
        }
        try
        {
            if (string.IsNullOrWhiteSpace(VmName))
            {
                vm = null;
                return;
            }

            vm = await Panel.GetVmAsync(Session.User, VmName);
            if (vm is null)
            {
                return;
            }

            ResetLazyTabStateIfVmChanged(vm.Name);

            if (!string.Equals(firewallRulesVmName, vm.Name, StringComparison.OrdinalIgnoreCase))
            {
                guestFirewallRules = [];
                firewallRulesLoaded = false;
                firewallRulesVmName = string.Empty;
            }

            access = await Panel.GetVmAccessInfoAsync(Session.User, vm.Name);
            CopyAccessToEditFields();

            // The network profile is cheap database state and is used by the sidebar and Access tab
            // to explain public -> private port routing. Keep it warm for admins, but leave the
            // expensive PowerShell/backup/firewall/reinstall reads lazy.
            if (Session.User!.IsAdmin)
            {
                networkProfile = await Panel.GetVmNetworkPortProfileAsync(Session.User, vm.Name);
                CopyNetworkProfileToEditFields();
                portConflicts = [];
                portCheckCompleted = false;
            }

            EnsureAllowedActiveTab();
            await LoadActiveTabDataAsync(force: true);
            lastLoaded = DateTime.Now;
        }
        catch (Exception ex)
        {
            vm = null;
            messageClass = "alert";
            message = ex.Message;
        }
        finally
        {
            if (showPageLoading)
            {
                loading = false;
            }
        }
    }

    private void ResetLazyTabStateIfVmChanged(string vmName)
    {
        if (string.Equals(tabDataVmName, vmName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        tabDataVmName = vmName;
        recoveryDataLoaded = false;
        backupsDataLoaded = false;
        reinstallDataLoaded = false;
        activityDataLoaded = false;
        settingsDataLoaded = false;
        rdpListenerStatus = null;
        guestAgentSettings = new(vmName, false, false, null, "", "", DateTime.UtcNow);
        guestAgentCommands = [];
        auditLogs = [];
        checkpoints = [];
        checkpointError = string.Empty;
        templates = [];
        reinstallRequests = [];
        publicStatusSettings = new(vmName, false, "", "", null, DateTime.UtcNow);
    }

    private async Task OpenTab(string tab)
    {
        if (!CanViewTab(tab))
        {
            return;
        }

        activeTab = tab;
        var needsRemoteLoad = TabNeedsLazyLoad(tab);
        if (needsRemoteLoad)
        {
            tabLoading = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            await LoadActiveTabDataAsync(force: false);
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
        }
        finally
        {
            if (needsRemoteLoad)
            {
                tabLoading = false;
            }
        }
    }

    private bool TabNeedsLazyLoad(string tab) => tab switch
    {
        "recovery" => !recoveryDataLoaded,
        "backups" => !backupsDataLoaded,
        "reinstall" => !reinstallDataLoaded,
        "activity" => !activityDataLoaded,
        "settings" => Session.User?.IsAdmin == true && !settingsDataLoaded,
        _ => false
    };

    private async Task LoadActiveTabDataAsync(bool force)
    {
        if (vm is null)
        {
            return;
        }

        switch (activeTab)
        {
            case "recovery" when CanViewTab("recovery") && (force || !recoveryDataLoaded):
                guestAgentSettings = await Panel.GetVmGuestAgentSettingsAsync(Session.User, vm.Name);
                guestAgentCommands = CanManageGuestAgent()
                    ? await Panel.GetGuestAgentCommandsForVmAsync(Session.User, vm.Name)
                    : [];
                if (string.IsNullOrWhiteSpace(emergencyUsername) || !CanManageGuestAgent())
                {
                    emergencyUsername = string.IsNullOrWhiteSpace(access.Username) ? "Administrator" : access.Username;
                }
                recoveryDataLoaded = true;
                break;

            case "backups" when CanViewTab("backups") && (force || !backupsDataLoaded):
                await LoadCheckpoints();
                backupsDataLoaded = true;
                break;

            case "reinstall" when CanViewTab("reinstall") && (force || !reinstallDataLoaded):
                templates = await Panel.GetVmTemplatesAsync(Session.User);
                reinstallRequests = await Panel.GetReinstallRequestsAsync(Session.User, vm.Name);
                reinstallDataLoaded = true;
                break;

            case "activity" when CanViewTab("activity") && (force || !activityDataLoaded):
                auditLogs = await Panel.GetAuditLogsForVmAsync(Session.User, vm.Name);
                activityDataLoaded = true;
                break;

            case "settings" when Session.User?.IsAdmin == true && (force || !settingsDataLoaded):
                publicStatusSettings = await Panel.GetVmPublicStatusSettingsAsync(Session.User, vm.Name);
                CopyPublicStatusToEditFields();
                settingsDataLoaded = true;
                break;
        }
    }

