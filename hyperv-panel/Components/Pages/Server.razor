    private static string SnapshotTypeText(VmQuickRestorePointInfo point) =>
        point.IsTemporarySafety ? "Temporary safety" : "Restore point";

    private static string SnapshotExpiryText(VmQuickRestorePointInfo point)
    {
        if (point.ExpiresAt is null) return "Managed";

        var remaining = point.ExpiresAt.Value - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return "Expired";
        if (remaining.TotalHours < 48) return $"{Math.Ceiling(remaining.TotalHours):0}h left";
        return $"{Math.Ceiling(remaining.TotalDays):0}d left";
    }

