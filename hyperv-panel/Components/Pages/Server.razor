    }

    private bool HasEffectiveWebConsoleUrl()
    {
        return UseBrowserConsole() && IsHttpUrl(EffectiveWebConsoleUrl());
    }

    private string EffectiveWebConsoleUrl()
    {
        if (!UseBrowserConsole())
        {
            return string.Empty;
        }

        if (UseGuacamoleJsonAuth())
        {
            var jsonAuthUrl = BuildGuacamoleJsonAuthUrl();
            if (!string.IsNullOrWhiteSpace(jsonAuthUrl))
            {
                return jsonAuthUrl;
            }
        }

        var storedValue = StoredConsoleValue();

        if (!string.IsNullOrWhiteSpace(storedValue) && WebRdpPreferPerVmUrl())
        {
            return BuildConsoleUrlFromValue(storedValue);
        }

        if (WebRdpEnabled() && WebRdpEmbedInConsole() && !string.IsNullOrWhiteSpace(WebRdpBaseUrl()))
        {
            var globalUrl = BuildWebRdpUrl();
            if (!string.IsNullOrWhiteSpace(globalUrl))
            {
                return globalUrl;
            }
        }

        if (!string.IsNullOrWhiteSpace(storedValue))
        {
            return BuildConsoleUrlFromValue(storedValue);
        }

        return string.Empty;
    }

    private string StoredConsoleValue() => access.WebConsoleUrl?.Trim() ?? string.Empty;

    private string BuildConsoleUrlFromValue(string value)
    {
        value = value.Trim();
        if (IsHttpUrl(value))
        {
            return value;
        }

        if (IsGuacamoleProvider() && !string.IsNullOrWhiteSpace(WebRdpBaseUrl()))
        {
            return BuildGuacamoleUrl(value);
        }

        return string.Empty;
    }

    private string BuildWebRdpUrl()
    {
        if (IsGuacamoleProvider())
        {
            var connectionId = GuacamoleConnectionId();
            return string.IsNullOrWhiteSpace(connectionId) ? string.Empty : BuildGuacamoleUrl(connectionId);
        }

        return BuildWebRdpUrlFromTemplate(WebRdpPathTemplate());
    }

    private string BuildGuacamoleUrl(string connectionIdOrPath)
    {
        var baseUrl = WebRdpBaseUrl().Trim().TrimEnd('/');
        if (string.IsNullOrWhiteSpace(baseUrl))
        {
            return string.Empty;
        }

        var value = connectionIdOrPath.Trim();
        if (IsHttpUrl(value))
        {
            return value;
        }

        var template = WebRdpPathTemplate();
        if (string.IsNullOrWhiteSpace(template) || !template.Contains("{connectionId}", StringComparison.OrdinalIgnoreCase))
        {
            template = "/#/client/{connectionId}";
        }

        // Guacamole connection IDs are already URL-safe and may contain route separators.
        // Preserve them exactly so copied values from /#/client/... continue to work.
        var cleanConnectionId = value.TrimStart('/');
        var path = template.Replace("{connectionId}", cleanConnectionId, StringComparison.OrdinalIgnoreCase);

        return baseUrl + "/" + path.TrimStart('/');
    }

    private string BuildWebRdpUrlFromTemplate(string? template)
    {
        var baseUrl = WebRdpBaseUrl().Trim().TrimEnd('/');
        if (string.IsNullOrWhiteSpace(baseUrl))
        {
            return string.Empty;
        }

        var host = !string.IsNullOrWhiteSpace(access.IpAddress) ? access.IpAddress : access.Hostname;
        var port = access.RdpPort is null or <= 0 ? "3389" : access.RdpPort.Value.ToString();
        var address = string.IsNullOrWhiteSpace(host) ? string.Empty : $"{host}:{port}";

        if (string.IsNullOrWhiteSpace(template))
        {
            template = "/";
        }

        template = template
            .Replace("{vm}", Uri.EscapeDataString(vm?.Name ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{host}", Uri.EscapeDataString(host ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{ip}", Uri.EscapeDataString(access.IpAddress ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{hostname}", Uri.EscapeDataString(access.Hostname ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{port}", Uri.EscapeDataString(port), StringComparison.OrdinalIgnoreCase)
            .Replace("{address}", Uri.EscapeDataString(address), StringComparison.OrdinalIgnoreCase)
            .Replace("{username}", Uri.EscapeDataString(access.Username ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{password}", Uri.EscapeDataString(access.Password ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{security}", Uri.EscapeDataString(WebRdpSecurity()), StringComparison.OrdinalIgnoreCase)
            .Replace("{connectionId}", GuacamoleConnectionId().TrimStart('/'), StringComparison.OrdinalIgnoreCase);

        if (Uri.TryCreate(template, UriKind.Absolute, out var absoluteTemplate))
        {
            return absoluteTemplate.ToString();
        }

        return baseUrl + "/" + template.TrimStart('/');
    }

    private string ConsoleModeText()
    {
        if (UseHyperVBasicConsole())
        {
            return "Hyper-V Basic Console";
        }

        if (UseNativeRdpConsole())
        {
            return "Native Windows Remote Desktop";
        }

        if (UseGuacamoleJsonAuth())
        {
            return "Legacy browser console - Guacamole auto-login";
        }

        if (HasEffectiveWebConsoleUrl())
        {
            return IsGuacamoleProvider()
                ? "Legacy browser console - Guacamole"
                : "Legacy browser RDP gateway";
        }

        return "Native Windows Remote Desktop fallback";
    }

    private string ConsoleAccessStatus()
    {
        if (UseHyperVBasicConsole())
        {
            return "Hyper-V Basic Console - no guest network required";
        }

        if (UseNativeRdpConsole())
        {
            return "Native Windows RDP - no gateway required";
        }

        if (HasEffectiveWebConsoleUrl())
        {
            return IsGuacamoleProvider()
                ? "Legacy Guacamole browser mode"
                : "Legacy browser gateway mode";
        }

        return "Native Windows RDP fallback";
    }

    private string ConsolePreviewText()
    {
        if (UseHyperVBasicConsole())
        {
            return "Hyper-V Basic Console is active. PenguinPanel reads the VM display and injects input through Hyper-V WMI; no browser gateway URL is required.";
        }

        if (UseNativeRdpConsole())
        {
            return "Native RDP mode is active. No browser-console URL is required.";
        }

        if (UseGuacamoleJsonAuth())
        {
            return "Legacy Guacamole JSON auto-login is enabled.";
        }

        var storedValue = StoredConsoleValue();
        if (!string.IsNullOrWhiteSpace(storedValue))
        {
            return $"This VM has its own legacy {ConsoleProvider()} console value. Preview: {EffectiveWebConsoleUrl()}";
        }

        if (WebRdpEnabled() && !string.IsNullOrWhiteSpace(WebRdpBaseUrl()))
        {
            var preview = EffectiveWebConsoleUrl();
            return string.IsNullOrWhiteSpace(preview)
                ? $"Legacy {ConsoleProvider()} browser mode is enabled, but no usable console URL was generated."
                : $"Legacy {ConsoleProvider()} console URL preview: {preview}";
        }

        return "No browser gateway is configured. Native Windows RDP will be used.";
    }

    private string ConsoleModeSetting()
    {
        var configured = (Configuration["Console:Mode"] ?? string.Empty).Trim();
        return string.IsNullOrWhiteSpace(configured) ? "HyperVBasic" : configured;
    }

    private bool UseHyperVBasicConsole() =>
        ConsoleModeSetting().Equals("HyperVBasic", StringComparison.OrdinalIgnoreCase)
        || ConsoleModeSetting().Equals("HyperV", StringComparison.OrdinalIgnoreCase)
        || ConsoleModeSetting().Equals("VmConnect", StringComparison.OrdinalIgnoreCase);

    private bool UseNativeRdpConsole() =>
        ConsoleModeSetting().Equals("NativeRdp", StringComparison.OrdinalIgnoreCase)
        || ConsoleModeSetting().Equals("Rdp", StringComparison.OrdinalIgnoreCase);

    private bool UseBrowserConsole() =>
        ConsoleModeSetting().Equals("Browser", StringComparison.OrdinalIgnoreCase)
        || ConsoleModeSetting().Equals("WebRdp", StringComparison.OrdinalIgnoreCase)
        || ConsoleModeSetting().Equals("Guacamole", StringComparison.OrdinalIgnoreCase);

    private bool UseGuacamoleJsonAuth()
    {
        return UseBrowserConsole()
            && IsGuacamoleProvider()
            && WebRdpEnabled()
            && WebRdpEmbedInConsole()
            && GuacamoleJsonAuth.IsEnabled
            && HasRdpTarget();
    }

    private string BuildGuacamoleJsonAuthUrl()
    {
        if (vm is null)
        {
            return string.Empty;
        }

        return GuacamoleJsonAuth.BuildConsoleUrl(
            WebRdpBaseUrl(),
            vm.Name,
            Session.User?.Username ?? "penguinpanel",
            access);
    }

    private bool WebRdpEnabled() => bool.TryParse(Configuration["WebRdp:Enabled"], out var enabled) && enabled;

    private bool WebRdpEmbedInConsole() => !bool.TryParse(Configuration["WebRdp:EmbedInConsole"], out var embed) || embed;

    private bool WebRdpPreferPerVmUrl() => !bool.TryParse(Configuration["WebRdp:PreferPerVmWebConsoleUrl"], out var prefer) || prefer;

    private string WebRdpBaseUrl() => Configuration["WebRdp:BaseUrl"] ?? string.Empty;

    private string WebRdpPathTemplate() => Configuration["WebRdp:PathTemplate"] ?? "/#/client/{connectionId}";

    private string WebRdpSecurity() => Configuration["WebRdp:Security"] ?? "NLA";

    private string ConsoleProvider() => string.IsNullOrWhiteSpace(Configuration["WebRdp:Provider"])
        ? "Guacamole"
        : Configuration["WebRdp:Provider"]!;

    private bool IsGuacamoleProvider() => ConsoleProvider().Equals("Guacamole", StringComparison.OrdinalIgnoreCase);

    private string GuacamoleConnectionId() => StoredConsoleValue();

    private static bool IsHttpUrl(string? value)
    {
        return Uri.TryCreate(value, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }

    private string RdpFileName()
    {
        var safeName = string.Join("_", (vm?.Name ?? "server").Split(Path.GetInvalidFileNameChars(), StringSplitOptions.RemoveEmptyEntries));
        return string.IsNullOrWhiteSpace(safeName) ? "server.rdp" : $"{safeName}.rdp";
    }

    private string RdpFileContent()
    {
        var lines = new List<string>
        {
            "screen mode id:i:2",
            "use multimon:i:0",
            "desktopwidth:i:1920",
            "desktopheight:i:1080",
            "session bpp:i:32",
            $"full address:s:{RdpText()}",
            "prompt for credentials:i:1",
            "promptcredentialonce:i:1",
            "authentication level:i:2",
            "enablecredsspsupport:i:1",
            "negotiate security layer:i:1",
            "gatewayusagemethod:i:0",
            "networkautodetect:i:1",
            "bandwidthautodetect:i:1",
            "compression:i:1",
            "autoreconnection enabled:i:1",
            "keyboardhook:i:2",
            "smart sizing:i:1",
            "dynamic resolution:i:1",
            "redirectclipboard:i:1",
            "redirectprinters:i:0",
            "redirectcomports:i:0",
            "redirectsmartcards:i:1",
            "redirectdrives:i:0",
            "audiocapturemode:i:0",
            "audiomode:i:0"
        };

        if (!string.IsNullOrWhiteSpace(access.Username))
        {
            lines.Add($"username:s:{access.Username}");
        }

        return string.Join("\r\n", lines) + "\r\n";
    }

    private string RdpDataUri() => "data:application/x-rdp;charset=utf-8," + Uri.EscapeDataString(RdpFileContent());

    private async Task CopyToClipboard(string value, string label)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            messageClass = "alert success";
            message = $"{label} copied to clipboard.";
        }
        catch
        {
            messageClass = "alert";
            message = $"Could not copy {label.ToLowerInvariant()} automatically. Select and copy it manually.";
        }
    }

