        return "Not set";
    }

    private string ConsolePreviewText()
    {
        if (UseGuacamoleJsonAuth())
        {
            return "Guacamole JSON auto-login is enabled. PenguinPanel generates a temporary Guacamole session from this VM's saved RDP details, so the client does not need a separate Guacamole login. The per-VM Guacamole URL/connection ID box should stay empty.";
        }

        var storedValue = StoredConsoleValue();
        if (!string.IsNullOrWhiteSpace(storedValue))
        {
            return $"This VM has its own {ConsoleProvider()} console value. Preview: {EffectiveWebConsoleUrl()}";
        }

        if (WebRdpEnabled() && !string.IsNullOrWhiteSpace(WebRdpBaseUrl()))
        {
            var preview = EffectiveWebConsoleUrl();
            return string.IsNullOrWhiteSpace(preview)
                ? $"Global {ConsoleProvider()} is enabled. Add a per-VM Guacamole connection URL or connection ID for this VM, or enable Guacamole JSON auto-login."
                : $"Global {ConsoleProvider()} is enabled. Console URL preview: {preview}";
        }

        return "Guacamole is disabled. Add a per-VM Guacamole URL/connection ID or enable WebRdp in appsettings.json.";
    }


    private bool UseGuacamoleJsonAuth()
    {
        return IsGuacamoleProvider()
            && WebRdpEnabled()
            && WebRdpEmbedInConsole()
            && GuacamoleJsonAuth.IsEnabled
            && HasRdpTarget();
    }

    private string BuildGuacamoleJsonAuthUrl()
    {
        if (vm is null)
        {
            return string.Empty;
        }

        return GuacamoleJsonAuth.BuildConsoleUrl(
            WebRdpBaseUrl(),
            vm.Name,
            Session.User?.Username ?? "penguinpanel",
            access);
    }

