@using Microsoft.AspNetCore.Components
@page "/server"
@implements IDisposable
@inject PanelService Panel
@inject UserSession Session
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject GuacamoleJsonAuthService GuacamoleJsonAuth

<PageTitle>Virtual Server</PageTitle>

@if (!Session.IsLoggedIn)
{
    <NotSignedIn />
}
else if (string.IsNullOrWhiteSpace(VmName))
{
    <section class="panel empty-state">
        <h1>No server selected</h1>
        <p>Open a server from the Virtual Servers page.</p>
        <a class="button primary" href="vms">View virtual servers</a>
    </section>
}
else if (loading)
{
    <section class="server-loading-shell" aria-live="polite">
        <div class="server-loading-card">
            <div class="server-loading-glow"></div>
            <div class="server-loading-icon" aria-hidden="true">🐧</div>
            <span class="eyebrow">PenguinPanel</span>
            <h1>Preparing your virtual server</h1>
            <p>We are checking the power state, resources, access details, and network profile for <strong>@VmName</strong>.</p>
            <div class="server-loading-bar" aria-hidden="true"><span></span></div>
            <div class="server-loading-steps" aria-hidden="true">
                <span>Power</span>
                <span>Resources</span>
                <span>Network</span>
            </div>
            <small>This usually only takes a few seconds.</small>
        </div>
    </section>
}
else if (vm is null)
{
    <section class="panel empty-state">
        <h1>Server unavailable</h1>
        <p>The VM could not be found, or it is not assigned to your account.</p>
        <a class="button primary" href="vms">Back to virtual servers</a>
    </section>
}
else
{
    <div class="server-titlebar">
        <div>
            <span class="eyebrow">Virtual Server</span>
            <h1>@vm.Name</h1>
            <p>Power controls, access details, backups, and reinstall requests for this virtual server.</p>
        </div>
        <div class="server-title-actions">
            <span class="status-chip @StateClass(vm.State)">@PrettyState(vm.State)</span>
            <button class="button" @onclick="() => Load()">Refresh</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="@messageClass">@message</div>
    }

    <div class="server-tabs" role="tablist" aria-label="Server sections">
        @if (CanViewTab("console"))
        {
            <button class='@TabClass("console")' @onclick='() => OpenTab("console")'>Console</button>
        }
        @if (CanViewTab("resources"))
        {
            <button class='@TabClass("resources")' @onclick='() => OpenTab("resources")'>Resources</button>
        }
        @if (CanViewTab("access"))
        {
            <button class='@TabClass("access")' @onclick='() => OpenTab("access")'>Access</button>
        }
        @if (CanViewTab("recovery"))
        {
            <button class='@TabClass("recovery")' @onclick='() => OpenTab("recovery")'>Password Reset</button>
        }
        @if (CanViewTab("network"))
        {
            <button class='@TabClass("network")' @onclick='() => OpenTab("network")'>Network</button>
            <button class='@TabClass("firewall")' @onclick="OpenFirewallTab">Windows Firewall</button>
        }
        @if (CanViewTab("backups"))
        {
            <button class='@TabClass("backups")' @onclick='() => OpenTab("backups")'>Backups</button>
        }
        @if (CanViewTab("reinstall"))
        {
            <button class='@TabClass("reinstall")' @onclick='() => OpenTab("reinstall")'>Reinstall</button>
        }
        @if (CanViewTab("activity"))
        {
            <button class='@TabClass("activity")' @onclick='() => OpenTab("activity")'>Activity</button>
        }
        @if (CanViewTab("settings"))
        {
            <button class='@TabClass("settings")' @onclick='() => OpenTab("settings")'>Settings</button>
        }
    </div>

    <div class="server-grid">
        <aside class="server-sidebar-card">
            <div class="server-icon-box">VM</div>
            <h2>@vm.Name</h2>
            <p>@(Session.User!.IsAdmin ? "Admin access" : "Assigned server")</p>

            <div class="mini-stats">
                <div><span>State</span><strong>@PrettyState(vm.State)</strong></div>
                <div><span>CPU</span><strong>@vm.CpuUsage%</strong></div>
                <div><span>Memory</span><strong>@FormatBytes(vm.MemoryAssigned)</strong></div>
                <div><span>Uptime</span><strong>@FormatUptime(vm.Uptime)</strong></div>
                <div><span>RDP</span><strong>@RdpText()</strong></div>
                @if (networkProfile.EnableFiveM && networkProfile.FiveMExternalPort is > 0)
                {
                    <div><span>FiveM</span><strong>@FiveMText()</strong></div>
                }
            </div>

            @if (CanUsePowerActions())
            {
                <div class="power-panel">
                    <button class="power start" @onclick='() => Run("start")' disabled='@(!CanRunPowerAction("start"))' title='@PowerActionTitle("start")'>Start</button>
                    <button class="power restart" @onclick='() => Run("restart")' disabled='@(!CanRunPowerAction("restart"))' title='@PowerActionTitle("restart")'>Restart</button>
                    <button class="power stop" @onclick='() => Run("stop")' disabled='@(!CanRunPowerAction("stop"))' title='@PowerActionTitle("stop")'>Stop</button>
                    <button class="power muted-power" @onclick='() => Run("suspend")' disabled='@(!CanRunPowerAction("suspend"))' title='@PowerActionTitle("suspend")'>Pause</button>
                    <button class="power muted-power" @onclick='() => Run("resume")' disabled='@(!CanRunPowerAction("resume"))' title='@PowerActionTitle("resume")'>Resume</button>
                </div>

                @if (powerInProgress)
                {
                    <div class="power-progress-card" aria-live="polite">
                        <div class="power-progress-head">
                            <span>@PowerProgressTitle()</span>
                            <strong>@powerProgress%</strong>
                        </div>
                        <div class="power-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@powerProgress">
                            <span style="@PowerProgressStyle"></span>
                        </div>
                        <p>@powerStatus</p>
                    </div>
                }
            }
            else
            {
                <div class="notice-card compact-notice">Power controls are disabled for your account.</div>
            }
        </aside>

        <main class="server-main-card">
            @if (tabLoading)
            {
                <div class="notice-card compact-notice"><strong>Loading @(TabDisplayName(activeTab))...</strong></div>
            }

            @if (!CanViewTab(activeTab))
            {
                <section class="empty-state">
                    <h2>Section hidden</h2>
                    <p>This tab is not enabled for your account. Ask an administrator to update your User Manager permissions.</p>
                </section>
            }
            else if (activeTab == "console")
            {
                <section>
                    <div class="panel-head">
                        <h2>Remote Desktop</h2>
                        <span class="muted">RDP console access for this virtual server</span>
                    </div>

                    @if (!HasRdpTarget())
                    {
                        <div class="notice-card">
                            <strong>RDP is not configured yet</strong>
                            <p>Add the VM IP/hostname and RDP port in the Access tab. No extra software is needed inside the VM, but Windows Remote Desktop must be enabled in the guest OS.</p>
                        </div>
                    }
                    else
                    {
                        <div class="rdp-console-layout">
                            <div class="rdp-console-card">
                                <div class="rdp-screen-header">
                                    <span class="dot-live"></span>
                                    <strong>@vm.Name</strong>
                                    <span>@RdpText()</span>
                                </div>

                                @if (!IsConsoleAvailableState(vm.State))
                                {
                                    <div class="rdp-placeholder-screen rdp-offline-screen">
                                        <div class="rdp-monitor-icon offline-monitor">⏻</div>
                                        <h3>Console unavailable while the server is @PrettyState(vm.State)</h3>
                                        <p>The browser console will open after the virtual server is running. PenguinPanel blocks Guacamole from loading while the VM is offline, so clients do not get stuck in a reconnect loop.</p>
                                        <div class="button-row big-actions centered-actions">
                                            @if (CanUsePowerActions())
                                            {
                                                <button class="button primary" @onclick='() => Run("start")' disabled='@(!CanRunPowerAction("start"))'>Start server</button>
                                            }
                                            <button class="button" @onclick="() => Load()">Refresh state</button>
                                        </div>
                                    </div>
                                }
                                else if (HasEffectiveWebConsoleUrl())
                                {
                                    <div class="web-rdp-frame-shell">
                                        <iframe class="rdp-frame" src="@EffectiveWebConsoleUrl()" title="@ConsoleProvider() remote desktop for @vm.Name" allow="clipboard-read; clipboard-write; fullscreen" allowfullscreen></iframe>
                                        <div class="web-rdp-frame-actions">
                                            <span>@ConsoleModeText()</span>
                                            <a class="button mini" href="@EffectiveWebConsoleUrl()" target="_blank" rel="noopener noreferrer">Open in new tab</a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="rdp-placeholder-screen">
                                        <div class="rdp-monitor-icon">▣</div>
                                        <h3>Remote Desktop launcher</h3>
                                        <p>Download the generated <strong>.rdp</strong> file or copy the connection details below. To embed the desktop here, enable Guacamole in <strong>appsettings.json</strong> or add a Guacamole connection URL/ID in the Access tab.</p>
                                        <div class="button-row big-actions centered-actions">
                                            <a class="button primary" href="@RdpDataUri()" download="@RdpFileName()">Download .RDP</a>
                                            <button class="button" @onclick='() => CopyToClipboard(RdpText(), "RDP address")'>Copy address</button>
                                        </div>
                                    </div>
                                }
                            </div>

                            <aside class="rdp-details-card">
                                <h3>Connection details</h3>
                                <div class="server-info-grid single-column-info">
                                    <div><span>Address</span><strong>@RdpText()</strong></div>
                                    <div><span>Username</span><strong>@ValueOrNotSet(access.Username)</strong></div>
                                    <div><span>Password</span><strong>@PasswordText()</strong></div>
                                </div>
                                <div class="button-row settings-actions">
                                    <button class="button" @onclick='() => CopyToClipboard(RdpText(), "RDP address")'>Copy address</button>
                                    <button class="button" @onclick='() => CopyToClipboard(access.Username, "Username")' disabled="@(string.IsNullOrWhiteSpace(access.Username))">Copy username</button>
                                    <button class="button" @onclick="() => showPassword = !showPassword">@(showPassword ? "Hide password" : "Show password")</button>
                                    <button class="button" @onclick='() => CopyToClipboard(access.Password, "Password")' disabled="@(string.IsNullOrWhiteSpace(access.Password))">Copy password</button>
                                </div>
                            </aside>
                        </div>

                        <div class="terminal-window remote-status-terminal">
                            <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[PenguinPanel]</span> Selected virtual server: @vm.Name</div>
                            <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[State]</span> @PrettyState(vm.State)</div>
                            <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[RDP]</span> @RdpText()</div>
                            <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[Mode]</span> @ConsoleModeText()</div>
                            @if (!string.IsNullOrWhiteSpace(lastAction))
                            {
                                <div><span class="term-time">[@DateTime.Now.ToString("HH:mm:ss")]</span> <span class="term-ok">[Action]</span> @lastAction</div>
                            }
                        </div>

                    }
                </section>
            }
            else if (activeTab == "resources")
            {
                <section>
                    <div class="panel-head">
                        <h2>Resource usage</h2>
                        <span class="muted">Live virtual server snapshot</span>
                    </div>
                    <div class="resource-grid">
                        <div class="resource-card">
                            <div class="resource-top"><span>CPU Usage</span><strong>@vm.CpuUsage%</strong></div>
                            <div class="usage-track"><div class="usage-fill" style="width:@(Clamp(vm.CpuUsage))%"></div></div>
                            <div class="fake-chart cpu-chart"><span style="height:@(Math.Max(8, Clamp(vm.CpuUsage)))%"></span></div>
                        </div>
                        <div class="resource-card">
                            <div class="resource-top"><span>Memory Assigned</span><strong>@FormatBytes(vm.MemoryAssigned)</strong></div>
                            <div class="usage-track"><div class="usage-fill" style="width:@(MemoryBarPercent(vm.MemoryAssigned))%"></div></div>
                            <div class="fake-chart memory-chart"><span style="height:@(MemoryBarPercent(vm.MemoryAssigned))%"></span></div>
                        </div>
                    </div>
                    <div class="server-info-grid">
                        <div><span>Status</span><strong>@(string.IsNullOrWhiteSpace(vm.Status) ? "No extra status" : vm.Status)</strong></div>
                        <div><span>Uptime</span><strong>@FormatUptime(vm.Uptime)</strong></div>
                        <div><span>Assigned memory</span><strong>@FormatBytes(vm.MemoryAssigned)</strong></div>
                        <div><span>Last refresh</span><strong>@lastLoaded.ToLocalTime()</strong></div>
                    </div>
                </section>
            }
            else if (activeTab == "access")
            {
                <section>
                    <div class="panel-head">
                        <h2>Server access</h2>
                        <span class="muted">RDP / SSH details for the assigned user</span>
                    </div>
                    <div class="server-info-grid">
                        <div><span>Hostname</span><strong>@ValueOrNotSet(access.Hostname)</strong></div>
                        <div><span>IP address</span><strong>@ValueOrNotSet(access.IpAddress)</strong></div>
                        <div><span>RDP</span><strong>@RdpText()</strong></div>
                        @if (networkProfile.EnableFiveM && networkProfile.FiveMExternalPort is > 0)
                        {
                            <div><span>FiveM</span><strong>@FiveMText()</strong></div>
                        }
                        <div><span>SSH</span><strong>@SshText()</strong></div>
                        <div><span>Username</span><strong>@ValueOrNotSet(access.Username)</strong></div>
                        <div><span>Password</span><strong>@PasswordText()</strong></div>
                        <div><span>Browser console</span><strong>@BrowserConsoleStatus()</strong></div>
                    </div>
                    <div class="button-row settings-actions">
                        <button class="button" @onclick="() => showPassword = !showPassword">@(showPassword ? "Hide password" : "Show password")</button>
                    </div>

                    @if (Session.User!.IsAdmin)
                    {
                        <div class="notice-card compact-notice">
                            <strong>RDP routing</strong>
                            <p><strong>Public:</strong> @RdpText()</p>
                            <p><strong>WinNAT target:</strong> @RdpNatTargetText()</p>
                            <p><strong>Windows listener:</strong> @RdpListenerText()</p>
                            <div class="button-row settings-actions">
                                <button class="button" @onclick="VerifyRdpListener" disabled="@(busy || rdpListenerChecking || rdpListenerChanging || string.IsNullOrWhiteSpace(access.Username) || string.IsNullOrWhiteSpace(access.Password))">@(rdpListenerChecking ? "Checking..." : "Verify Windows RDP listener")</button>
                                <button class="button primary soft" @onclick="SyncRdpPortToPublic" disabled="@(busy || rdpListenerChecking || rdpListenerChanging || string.IsNullOrWhiteSpace(access.Username) || string.IsNullOrWhiteSpace(access.Password))">@(rdpListenerChanging ? "Changing RDP port..." : "Match Windows RDP to public port")</button>
                            </div>
                            <p class="muted">New VPSes can use the same public and Windows RDP port. Older VPSes may still listen on TCP 3389. <strong>Match Windows RDP to public port</strong> updates Windows, the guest firewall, and WinNAT together. Any active RDP session can disconnect for a few seconds while Remote Desktop Services restarts.</p>
                        </div>
                    }

                    <hr class="soft-line" />
                    <div class="panel-head sub-head">
                        <h2>Change Remote Desktop password</h2>
                        <span class="muted">Updates Windows and the saved panel password</span>
                    </div>
                    <div class="form-grid">
                        <label>New password<input type="password" @bind="remoteDesktopPassword" autocomplete="new-password" disabled="@busy" /></label>
                        <label>Confirm password<input type="password" @bind="remoteDesktopConfirmPassword" autocomplete="new-password" disabled="@busy" /></label>
                        <div class="form-actions full-row">
                            <button class="button" @onclick="GenerateRemoteDesktopPassword" disabled="@busy">Generate password</button>
                            <button class="button primary" @onclick="ChangeRemoteDesktopPassword" disabled="@(busy || string.IsNullOrWhiteSpace(remoteDesktopPassword))">Change RDP password</button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(access.Notes))
                    {
                        <div class="notice-card access-notes">
                            <strong>Notes</strong>
                            <p>@access.Notes</p>
                        </div>
                    }

                    @if (Session.User!.IsAdmin)
                    {
                        <hr class="soft-line" />
                        <div class="panel-head">
                            <h2>Edit access details</h2>
                            <span class="muted">Visible to assigned users</span>
                        </div>
                                                <div class="form-grid">
                            <label>Hostname<input @bind="accessHost" /></label>
                            <label>IP address<input @bind="accessIp" /></label>
                            <label>Public RDP port<input type="number" @bind="accessRdpPort" /></label>
                            <label>SSH port<input type="number" @bind="accessSshPort" /></label>
                            <label>Username<input @bind="accessUsername" /></label>
                            <label>Password<input type="text" @bind="accessPassword" /></label>
                            <label class="full-row">Guacamole console URL / connection ID<input @bind="accessWebConsoleUrl" placeholder="Paste the full Guacamole connection URL, or only the connection ID after /#/client/." /></label>
                            <div class="notice-card full-row compact-notice">
                                <strong>Guacamole preview</strong>
                                <p>@ConsolePreviewText()</p>
                                @if (HasEffectiveWebConsoleUrl())
                                {
                                    <a class="button mini" href="@EffectiveWebConsoleUrl()" target="_blank" rel="noopener noreferrer">Open current console</a>
                                }
                            </div>
                            <label class="full-row">Notes<textarea @bind="accessNotes"></textarea></label>
                            <div class="form-actions full-row">
                                <button class="button primary" @onclick="SaveAccess" disabled="@busy">Save access details</button>
                                <button class="button" @onclick="GenerateVmPassword" disabled="@busy">Generate password</button>
                                <button class="button danger" @onclick="ResetStoredPassword" disabled="@(busy || string.IsNullOrWhiteSpace(accessPassword))">Save as new stored password</button>
                            </div>
                        </div>
                    }
                </section>
            }
            else if (activeTab == "recovery")
            {
                <section>
                    <div class="panel-head">
                        <h2>Emergency Guest Agent reset</h2>
                        <span class="muted">Password recovery and Guest Agent status</span>
                    </div>
                    <div class="notice-card compact-notice">
                        <strong>Use this when RDP access is lost or compromised</strong>
                        <p>This tab changes the Windows password from inside the VM through PenguinGuestAgent. It is separated from normal access details so clients can find recovery faster and avoid changing Guest Agent setup by mistake.</p>
                    </div>
                    @if (CanManageGuestAgent())
                    {
                        <div class="server-info-grid">
                            <div><span>Agent</span><strong>@GuestAgentStatusText()</strong></div>
                            <div><span>Last seen</span><strong>@GuestAgentLastSeenText()</strong></div>
                            <div><span>Version</span><strong>@ValueOrNotSet(guestAgentSettings.LastAgentVersion)</strong></div>
                            <div><span>Last IP</span><strong>@ValueOrNotSet(guestAgentSettings.LastIpAddress)</strong></div>
                        </div>

                        <div class="notice-card compact-notice">
                            <strong>Agent setup</strong>
                            <p>Generate a unique token for this VM, then install <code>PenguinGuestAgent</code> inside the Windows VM or inside your VM template.</p>
                            @if (!string.IsNullOrWhiteSpace(generatedGuestAgentToken))
                            {
                                <p><strong>Copy this token now. It is only shown once:</strong></p>
                                <code>@generatedGuestAgentToken</code>
                                <div class="button-row settings-actions">
                                    <button class="button mini" @onclick='() => CopyToClipboard(generatedGuestAgentToken, "Guest Agent token")'>Copy token</button>
                                </div>
                            }
                            <div class="button-row settings-actions">
                                <button class="button primary" @onclick="GenerateGuestAgentToken" disabled="@busy">Generate / rotate agent token</button>
                                <button class="button" @onclick='() => SetGuestAgentEnabled(true)' disabled="@(busy || !guestAgentSettings.HasToken)">Enable agent</button>
                                <button class="button danger" @onclick='() => SetGuestAgentEnabled(false)' disabled="@busy">Disable agent</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="server-info-grid">
                            <div><span>Password recovery</span><strong>@ClientGuestAgentStatusText()</strong></div>
                            <div><span>Last check-in</span><strong>@GuestAgentLastSeenText()</strong></div>
                        </div>
                    }

                    @if (!CanUseEmergencyGuestReset())
                    {
                        <div class="notice-card compact-notice">
                            <strong>Emergency reset locked</strong>
                            <p>Emergency password reset is only available to the account owner and administrators. Sub-users can still view access details if that permission is enabled.</p>
                        </div>
                    }
                    else if (!guestAgentSettings.IsEnabled || !guestAgentSettings.HasToken)
                    {
                        <div class="notice-card compact-notice">
                            <strong>Password recovery is not ready</strong>
                            <p>An administrator needs to install and enable the Guest Agent for this VM before emergency password reset can be used.</p>
                        </div>
                    }
                    else
                    {
                        <div class="form-grid">
                            <label>Windows username<input @bind="emergencyUsername" disabled="@(busy || !CanManageGuestAgent())" /></label>
                            @if (!CanManageGuestAgent())
                            {
                                <div class="notice-card compact-notice full-row">
                                    <strong>Safe client mode</strong>
                                    <p>The reset uses the saved RDP username for this server. Agent setup, token rotation, and dangerous recovery options are hidden to prevent accidental lockouts.</p>
                                </div>
                            }
                            <label>New password<input type="@EmergencyPasswordInputType" @bind="emergencyPassword" autocomplete="new-password" disabled="@busy" /></label>
                            <label>Confirm password<input type="@EmergencyPasswordInputType" @bind="emergencyConfirmPassword" autocomplete="new-password" disabled="@busy" /></label>
                            <label>Reset verification code<input @bind="emergencyVerificationCode" inputmode="numeric" autocomplete="one-time-code" placeholder="6-digit email code" disabled="@busy" /></label>
                            <div class="notice-card compact-notice full-row">
                                <strong>Extra security step</strong>
                                <p>Before queueing an emergency reset, send a one-time code to your panel account email and enter it here. This helps stop someone with an open browser session from changing a VM password without email access.</p>
                                <div class="button-row settings-actions">
                                    <button class="button mini" @onclick="SendEmergencyResetCode" disabled="@(busy || !guestAgentSettings.IsEnabled || !guestAgentSettings.HasToken)">Email reset code</button>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(emergencyPassword))
                            {
                                <div class="notice-card compact-notice full-row">
                                    <strong>Emergency password ready</strong>
                                    <p>Copy this password before queueing the reset. It is cleared from the page after the reset is queued or when the page reloads.</p>
                                    <div class="server-info-grid compact-secret-grid">
                                        <div><span>Username</span><strong>@ValueOrNotSet(emergencyUsername)</strong></div>
                                        <div><span>Password</span><strong>@EmergencyPasswordText()</strong></div>
                                    </div>
                                    <div class="button-row settings-actions">
                                        <button class="button mini" @onclick="ToggleEmergencyPasswordVisibility" disabled="@busy">@(showEmergencyPassword ? "Hide password" : "Show password")</button>
                                        <button class="button mini" @onclick='() => CopyToClipboard(emergencyPassword, "Emergency password")' disabled="@busy">Copy password</button>
                                    </div>
                                </div>
                            }
                            @if (CanManageGuestAgent())
                            {
                                <label class="check-row"><input type="checkbox" @bind="emergencyForceLogoffSessions" disabled="@busy" /> Sign out active RDP sessions</label>
                                <label class="check-row"><input type="checkbox" @bind="emergencyRestartRemoteDesktopService" disabled="@busy" /> Restart Remote Desktop service</label>
                                <label class="check-row"><input type="checkbox" @bind="emergencyDisableRemoteDesktopFirewall" disabled="@busy" /> Disable Windows Remote Desktop firewall rule after reset</label>
                                <label class="check-row"><input type="checkbox" @bind="emergencyDisableOtherLocalAdministrators" disabled="@busy" /> Disable other local Administrator-group users</label>
                            }
                            <label class="check-row"><input type="checkbox" @bind="emergencySendPasswordEmail" disabled="@busy" /> Email the new password to my panel account email</label>
                            <div class="form-actions full-row">
                                <button class="button" @onclick="GenerateEmergencyPassword" disabled="@busy">Generate emergency password</button>
                                <button class="button danger" @onclick="QueueEmergencyPasswordReset" disabled="@(busy || string.IsNullOrWhiteSpace(emergencyPassword) || (EmergencyResetCodeRequired && string.IsNullOrWhiteSpace(emergencyVerificationCode)) || !guestAgentSettings.IsEnabled || !guestAgentSettings.HasToken)">Queue emergency reset</button>
                            </div>
                        </div>
                    }

                    @if (CanManageGuestAgent() && guestAgentCommands.Count > 0)
                    {
                        <div class="table-wrap compact-table-wrap">
                            <table class="data-table compact-table">
                                <thead><tr><th>ID</th><th>Command</th><th>Status</th><th>Created</th><th>Completed</th><th>Result</th></tr></thead>
                                <tbody>
                                    @foreach (var command in guestAgentCommands)
                                    {
                                        <tr>
                                            <td>@command.Id</td>
                                            <td>@command.CommandType</td>
                                            <td>@command.Status</td>
                                            <td>@command.CreatedAt.ToLocalTime()</td>
                                            <td>@(command.CompletedAt?.ToLocalTime().ToString() ?? "-")</td>
                                            <td>@ValueOrNotSet(command.ResultMessage)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </section>
            }
            else if (activeTab == "network")
            {
                <section>
                    <div class="panel-head">
                        <h2>Network</h2>
                        <span class="muted">Connection and protection actions</span>
                    </div>
                    <div class="notice-card">
                        <strong>Connection info</strong>
                        <p>RDP target: <strong>@RdpText()</strong>. Admins can scan outbound traffic using host resource metering and disconnect the VM network adapter if needed.</p>
                    </div>
                    @if (Session.User!.IsAdmin)
                    {
                        <div class="button-row big-actions">
                            <button class="button primary" @onclick="ScanNetwork" disabled="@busy">Scan outbound traffic</button>
                            <button class="button danger" @onclick='() => Run("disconnect")' disabled="@busy">Disconnect network</button>
                        </div>
                        <hr class="soft-line" />
                        <div class="panel-head sub-head">
                            <h2>Network / port profile</h2>
                            <span class="muted">Re-applied after template reinstall</span>
                        </div>
                        <div class="notice-card compact-notice">
                            <strong>Why this matters</strong>
                            <p>PenguinPanel keeps the same VM specs during reinstall. This profile makes sure the same internal IPv4, RDP port, FiveM TCP/UDP ports and extra NAT/firewall rules are saved and can be re-applied after the disk is replaced. Use the WinNAT object name from <code>Get-NetNat</code>, not the vEthernet adapter name.</p>
                        </div>
                        <div class="form-grid">
                            <label>NAT name<input @bind="profileNatName" placeholder="WinNAT name, e.g. HPanel-NAT — not vEthernet (HPanel-NAT)" /></label>
                            <label>Internal VM IPv4<input @bind="profileInternalIp" placeholder="192.168.119.100" /></label>
                            <label>Public IPv4<input @bind="profilePublicIp" placeholder="81.16.177.72" /></label>
                            <label>Public hostname<input @bind="profilePublicHostname" placeholder="example.penguinhosting.host" /></label>
                            <div class="notice-card full-row compact-notice">
                                <strong>Guest DNS / internet repair</strong>
                                <p>Guest DNS normally uses PenguinGuestAgent. If the VM has no internet and the agent cannot check in, use <strong>Repair guest internet</strong>. It uses Hyper-V PowerShell Direct from the host with the saved Access-tab Windows credentials, so it can fix IP/gateway/DNS even before the VM can reach the panel.</p>
                            </div>
                            <label>DNS interface alias<input @bind="profileDnsInterfaceAlias" placeholder="Auto, or e.g. Ethernet 2" /></label>
                            <div class="form-grid two-col-inline">
                                <label>Preferred DNS server<input @bind="profilePreferredDns" placeholder="81.16.177.72" /></label>
                                <label>Alternate DNS server<input @bind="profileAlternateDns" placeholder="1.1.1.1" /></label>
                            </div>
                            <label class="switch-row"><input type="checkbox" @bind="profileEnableRdp" /> Keep RDP NAT rule</label>
                            <div class="form-grid two-col-inline">
                                <label>RDP external port<input type="number" @bind="profileRdpExternalPort" /></label>
                                <label>Windows RDP / internal port<input type="number" @bind="profileRdpInternalPort" /></label>
                            </div>
                            <label class="switch-row"><input type="checkbox" @bind="profileEnableFiveM" /> Keep FiveM TCP/UDP rules</label>
                            <div class="form-grid two-col-inline">
                                <label>FiveM external port<input type="number" @bind="profileFiveMExternalPort" /></label>
                                <label>FiveM internal port<input type="number" @bind="profileFiveMInternalPort" /></label>
                            </div>
                            <label class="full-row">Extra TCP ports<textarea @bind="profileExtraTcpPorts" placeholder="One per line or comma-separated. Use external:internal, example: 40120:30120"></textarea></label>
                            <label class="full-row">Extra UDP ports<textarea @bind="profileExtraUdpPorts" placeholder="One per line or comma-separated. Example: 40120:30120"></textarea></label>
                            <div class="notice-card full-row compact-notice">
                                <strong>Current profile preview</strong>
                                <p>@NetworkProfilePreview()</p>
                            </div>
                            @if (portConflicts.Count > 0)
                            {
                                <div class="notice-card full-row compact-notice danger-note">
                                    <strong>Port conflict detected</strong>
                                    <ul>
                                        @foreach (var conflict in portConflicts)
                                        {
                                            <li>@conflict.Protocol/@conflict.ExternalPort is already used by @conflict.ConflictVmName</li>
                                        }
                                    </ul>
                                </div>
                            }
                            else if (portCheckCompleted)
                            {
                                <div class="notice-card full-row compact-notice success-note">No port conflicts found for this profile.</div>
                            }
                            <div class="form-actions full-row button-row">
                                <button class="button" @onclick="CopyNetworkProfileFromAccess" disabled="@busy">Copy from Access tab</button>
                                <button class="button" @onclick="CheckPortConflicts" disabled="@busy">Check conflicts</button>
                                <button class="button primary" @onclick="SaveNetworkProfile" disabled="@busy">Save network profile</button>
                                <button class="button" @onclick="ApplyGuestDnsSettings" disabled="@busy">Apply guest DNS now</button>
                                <button class="button" @onclick="RepairGuestInternet" disabled="@busy">Repair guest internet</button>
                                <button class="button primary soft" @onclick="ApplyNetworkProfile" disabled="@busy">Apply NAT/firewall + DNS now</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="muted">Network abuse tools are admin-only.</p>
                    }
                </section>
            }
            else if (activeTab == "firewall")
            {
                <section>
                    <div class="panel-head">
                        <h2>Windows Firewall</h2>
                        <span class="muted">Firewall rules inside this Windows VPS</span>
                    </div>

                    <div class="notice-card">
                        <strong>Guest firewall, not the Hyper-V host firewall</strong>
                        <p>These rules are created inside Windows using Hyper-V PowerShell Direct. The Network tab still controls the host WinNAT and host firewall mappings. <strong>Sync from network profile</strong> opens the VM-side RDP, FiveM, and extra internal ports saved in PenguinPanel.</p>
                    </div>

                    <div class="button-row big-actions">
                        <button class="button primary" @onclick="SyncGuestFirewall" disabled="@busy">Sync from network profile</button>
                        <button class="button" @onclick="LoadGuestFirewallRules" disabled="@busy">Refresh rules</button>
                    </div>

                    <hr class="soft-line" />
                    <div class="panel-head sub-head">
                        <h2>Add inbound rule</h2>
                        <span class="muted">PenguinPanel-managed rules only</span>
                    </div>
                    <div class="form-grid">
                        <label>Rule name<input @bind="firewallRuleName" placeholder="FiveM HTTP, game query, web panel..." /></label>
                        <label>Protocol
                            <select @bind="firewallProtocol">
                                <option value="TCP">TCP</option>
                                <option value="UDP">UDP</option>
                            </select>
                        </label>
                        <label>Local port<input type="number" min="1" max="65535" @bind="firewallLocalPort" /></label>
                        <label>Remote address<input @bind="firewallRemoteAddress" placeholder="Any, 203.0.113.20, or 203.0.113.0/24" /></label>
                        @if (Session.User!.IsAdmin)
                        {
                            <label>Action
                                <select @bind="firewallAction">
                                    <option value="Allow">Allow</option>
                                    <option value="Block">Block</option>
                                </select>
                            </label>
                        }
                        else
                        {
                            <label>Action<input value="Allow" disabled /></label>
                        }
                        <div class="form-actions full-row">
                            <button class="button primary" @onclick="AddGuestFirewallRule" disabled="@busy">Add Windows Firewall rule</button>
                        </div>
                    </div>

                    <hr class="soft-line" />
                    <div class="panel-head sub-head">
                        <h2>PenguinPanel firewall rules</h2>
                        <span class="muted">Automatic rules are rebuilt from the Network profile</span>
                    </div>
                    @if (!firewallRulesLoaded)
                    {
                        <p class="muted">Open this tab or press Refresh rules to read the Windows Firewall rules from the running VM.</p>
                    }
                    else if (guestFirewallRules.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <div class="empty-icon">▦</div>
                            <div>
                                <strong>No PenguinPanel Windows Firewall rules yet</strong>
                                <p class="muted">Use Sync from network profile to add RDP/FiveM rules, or create a custom inbound rule above.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <table class="data-table compact-table">
                            <thead><tr><th>Name</th><th>Protocol</th><th>Port</th><th>Remote</th><th>Action</th><th>Source</th><th>Actions</th></tr></thead>
                            <tbody>
                                @foreach (var rule in guestFirewallRules)
                                {
                                    <tr>
                                        <td><strong>@rule.DisplayName</strong></td>
                                        <td>@rule.Protocol</td>
                                        <td>@rule.LocalPort</td>
                                        <td>@rule.RemoteAddress</td>
                                        <td><span class="pill">@(rule.Enabled ? rule.Action : "Disabled")</span></td>
                                        <td>@(rule.IsAutomatic ? "Network profile" : "Custom")</td>
                                        <td>
                                            @if (rule.IsAutomatic)
                                            {
                                                <span class="muted">Change Network profile</span>
                                            }
                                            else
                                            {
                                                <button class="button mini danger" @onclick="() => RemoveGuestFirewallRule(rule)" disabled="@busy">Delete</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            }
            else if (activeTab == "backups")
            {
                <section>
                    <div class="panel-head">
                        <h2>Backups / checkpoints</h2>
                        <span class="muted">Restore points for this VM</span>
                    </div>
                    <div class="notice-card restore-safety-note">
                        <strong>Safe restore mode</strong>
                        <p>Restoring a checkpoint will temporarily stop this VM first. After the restore is finished, the VM stays stopped so you can start it again when you are ready.</p>
                    </div>
                    @if (restoreInProgress || !string.IsNullOrWhiteSpace(restoreStatus))
                    {
                        <div class="restore-progress-card">
                            <div class="restore-progress-head">
                                <strong>@(restoreInProgress ? "Restoring checkpoint" : "Last restore status")</strong>
                                <span>@restoreProgress%</span>
                            </div>
                            <div class="restore-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@restoreProgress">
                                <div class="restore-progress-bar" style="@RestoreProgressStyle"></div>
                            </div>
                            <p>@restoreStatus</p>
                        </div>
                    }
                    <div class="inline-form checkpoint-create">
                        <input @bind="checkpointName" placeholder="Backup name, optional" />
                        <button class="button primary" @onclick="CreateCheckpoint" disabled="@(busy || restoreInProgress)">Create checkpoint</button>
                        <button class="button" @onclick="LoadCheckpoints" disabled="@(busy || restoreInProgress)">Refresh</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(checkpointError))
                    {
                        <div class="alert">Could not load restore points: @checkpointError</div>
                    }
                    @if (checkpoints.Count == 0)
                    {
                        <div class="empty-state compact-empty">
                            <div class="empty-icon">↺</div>
                            <div>
                                <strong>No restore points visible yet</strong>
                                <p class="muted">Create a checkpoint, then use Refresh if it does not appear after a few seconds. Restore and delete buttons will show next to each checkpoint.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <table class="data-table compact-table">
                            <thead><tr><th>Name</th><th>Type</th><th>Created</th><th>Actions</th></tr></thead>
                            <tbody>
                                @foreach (var checkpoint in checkpoints)
                                {
                                    <tr>
                                        <td><strong>@checkpoint.Name</strong></td>
                                        <td>@checkpoint.SnapshotType</td>
                                        <td>@checkpoint.CreationTime.ToLocalTime()</td>
                                        <td class="button-row">
                                            <button class="button primary soft" @onclick="() => RestoreCheckpoint(checkpoint.Name)" disabled="@(busy || restoreInProgress)">Restore safely</button>
                                            <button class="button danger" @onclick="() => DeleteCheckpoint(checkpoint.Name)" disabled="@(busy || restoreInProgress)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            }
            else if (activeTab == "reinstall")
            {
                <section>
                    <div class="panel-head">
                        <h2>Reinstall</h2>
                        <span class="muted">@(Session.User!.IsAdmin ? "Admin reinstall" : "Self-service OS reinstall")</span>
                    </div>

                    @if (templates.Where(t => t.IsEnabled || Session.User!.IsAdmin).Any())
                    {
                        <div class="notice-card">
                            <strong>@(Session.User!.IsAdmin ? "Template reinstall" : "Self-service reinstall")</strong>
                            <p>@(Session.User!.IsAdmin
                                ? "Pick one of the global OS templates from OS Templates. PenguinPanel will stop this VM, replace its OS disk with a fresh copy of the selected VHDX, preserve the old disk, start it again, and re-apply the saved Network / port profile."
                                : "Choose an operating system and PenguinPanel will reinstall this server automatically. The server will go offline temporarily while the OS disk is replaced, then it will start again when the reinstall is finished.")</p>
                        </div>

                        @if (reinstallInProgress || !string.IsNullOrWhiteSpace(reinstallStatus))
                        {
                            <div class="restore-progress-card reinstall-progress-card" aria-live="polite">
                                <div class="restore-progress-head">
                                    <strong>@(reinstallInProgress ? "Reinstalling server" : "Last reinstall status")</strong>
                                    <span>@reinstallProgress%</span>
                                </div>
                                <div class="restore-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@reinstallProgress">
                                    <div class="restore-progress-bar" style="@ReinstallProgressStyle"></div>
                                </div>
                                <p>@reinstallStatus</p>
                            </div>
                        }

                        <div class="form-grid">
                            <label>
                                Operating system / template
                                <select @bind="selectedTemplateId">
                                    <option value="0">Select template</option>
                                    @foreach (var template in templates.Where(t => t.IsEnabled || Session.User!.IsAdmin))
                                    {
                                        <option value="@template.Id">@template.Name (@template.OperatingSystem)</option>
                                    }
                                </select>
                            </label>
                            @if (SelectedReinstallTemplate is { } selectedTemplate && !string.IsNullOrWhiteSpace(selectedTemplate.Notes))
                            {
                                <div class="notice-card full-row template-client-note">
                                    <strong>After reinstall</strong>
                                    <p>@selectedTemplate.Notes</p>
                                </div>
                            }
                            @if (Session.User!.IsAdmin)
                            {
                                <label class="full-row">Admin note<textarea @bind="reinstallNotes" placeholder="Optional internal note for the audit log"></textarea></label>
                            }
                            <div class="form-actions full-row">
                                <button class="button primary" @onclick="RunDirectReinstallNow" disabled="@(busy || reinstallInProgress || selectedTemplateId == 0)">@(Session.User!.IsAdmin ? "Reinstall this server now" : "Reinstall server now")</button>
                                @if (Session.User!.IsAdmin)
                                {
                                    <a class="button" href="templates">Manage OS Templates</a>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="friendly-empty-state">
                            <div class="empty-illustration">▤</div>
                            <div>
                                <h2>No reinstall templates available</h2>
                                <p>@(Session.User!.IsAdmin ? "Add a global VHDX template in OS Templates, then return here to reinstall this server." : "No reinstall templates are available for clients yet. Please contact support if you need an OS reinstall.")</p>
                                @if (Session.User!.IsAdmin)
                                {
                                    <a class="button primary" href="templates">Open OS Templates</a>
                                }
                            </div>
                        </div>
                    }
                    @if (Session.User!.IsAdmin)
                    {
                        <hr class="soft-line" />
                        <div class="panel-head sub-head">
                            <h2>Recent reinstall requests</h2>
                            <span class="muted">Requests for this server</span>
                        </div>
                        @if (reinstallRequests.Count == 0)
                        {
                            <p class="muted">No reinstall requests yet.</p>
                        }
                        else
                        {
                            <table class="data-table compact-table">
                                <thead><tr><th>Time</th><th>Template</th><th>Status</th><th>Notes</th><th>Actions</th></tr></thead>
                                <tbody>
                                    @foreach (var request in reinstallRequests)
                                    {
                                        <tr>
                                            <td>@request.CreatedAt.ToLocalTime()</td>
                                            <td>@request.TemplateName</td>
                                            <td><span class="pill">@request.Status</span></td>
                                            <td>@request.Notes</td>
                                            <td class="button-row">
                                                <button class="button mini primary" @onclick='() => RunReinstallNow(request.Id)' disabled='@(busy || reinstallInProgress || string.Equals(request.Status, "completed", StringComparison.OrdinalIgnoreCase))'>Run now</button>
                                                <button class="button mini" @onclick='() => UpdateRequestStatus(request.Id, "rejected")' disabled="@(busy || reinstallInProgress)">Reject</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                </section>
            }
            else if (activeTab == "activity")
            {
                <section>
                    <div class="panel-head">
                        <h2>Activity</h2>
                        <span class="muted">Recent actions for this VM</span>
                    </div>
                    @if (auditLogs.Count == 0)
                    {
                        <p class="muted">No audit entries for this VM yet.</p>
                    }
                    else
                    {
                        <table class="data-table compact-table">
                            <thead><tr><th>Time</th><th>Action</th><th>Details</th></tr></thead>
                            <tbody>
                                @foreach (var log in auditLogs)
                                {
                                    <tr>
                                        <td>@log.CreatedAt.ToLocalTime()</td>
                                        <td><span class="pill">@log.Action</span></td>
                                        <td>@log.Details</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            }
            else if (activeTab == "settings")
            {
                <section>
                    <div class="panel-head">
                        <h2>Settings</h2>
                        <span class="muted">Server access and permissions</span>
                    </div>
                    <div class="settings-list server-settings-list">
                        <div><span>Server name</span><strong>@vm.Name</strong></div>
                        <div><span>Panel role</span><strong>@Session.User!.Role</strong></div>
                        <div><span>Access scope</span><strong>@(Session.User!.IsAdmin ? "All virtual servers" : "Only assigned virtual servers")</strong></div>
                        <div><span>Permission enforcement</span><strong>User Manager + backend checked</strong></div>
                        <div><span>Enabled tabs</span><strong>@string.Join(", ", AllowedTabs())</strong></div>
                        <div><span>Remote console</span><strong>@ConsoleModeText()</strong></div>
                    </div>
                    @if (Session.User!.IsAdmin)
                    {
                        <hr class="soft-line" />
                        <div class="panel-head sub-head">
                            <h2>Public status integration</h2>
                            <span class="muted">Expose safe status data through /api/public/status</span>
                        </div>
                        <div class="form-grid">
                            <label class="switch-row full-row"><input type="checkbox" @bind="publicStatusEnabled" /> Show this VM in the public status API</label>
                            <label>Display name<input @bind="publicStatusDisplayName" placeholder="Public server name" /></label>
                            <label>Port to show/check<input type="number" @bind="publicStatusPort" placeholder="Optional" /></label>
                            <label class="full-row">Public note<textarea @bind="publicStatusNote" placeholder="Optional note for your status page"></textarea></label>
                            <div class="notice-card full-row compact-notice">
                                <strong>Status endpoint</strong>
                                <p>Use <code>/api/public/status</code> from your Penguin status site. It only exposes VMs you enable here.</p>
                            </div>
                            <div class="form-actions full-row">
                                <button class="button primary" @onclick="SavePublicStatusSettings" disabled="@busy">Save public status settings</button>
                            </div>
                        </div>

                        <div class="form-actions settings-actions">
                            <a class="button" href="users">Manage assignments</a>
                            <a class="button" href="abuse">Abuse protection</a>
                        </div>
                    }
                </section>
            }
        </main>
    </div>
}

