    private bool HasWebConsoleUrl()
    {
        var value = StoredConsoleValue();
        return IsHttpUrl(value) || (IsGuacamoleProvider() && !string.IsNullOrWhiteSpace(value));
    }

    private bool HasEffectiveWebConsoleUrl()
    {
        return IsHttpUrl(EffectiveWebConsoleUrl());
    }

    private string EffectiveWebConsoleUrl()
    {
        if (UseGuacamoleJsonAuth())
        {
            var jsonAuthUrl = BuildGuacamoleJsonAuthUrl();
            if (!string.IsNullOrWhiteSpace(jsonAuthUrl))
            {
                return jsonAuthUrl;
            }
        }

        var storedValue = StoredConsoleValue();

        if (!string.IsNullOrWhiteSpace(storedValue) && WebRdpPreferPerVmUrl())
        {
            return BuildConsoleUrlFromValue(storedValue);
        }

        if (WebRdpEnabled() && WebRdpEmbedInConsole() && !string.IsNullOrWhiteSpace(WebRdpBaseUrl()))
        {
            var globalUrl = BuildWebRdpUrl();
            if (!string.IsNullOrWhiteSpace(globalUrl))
            {
                return globalUrl;
            }
        }

        if (!string.IsNullOrWhiteSpace(storedValue))
        {
            return BuildConsoleUrlFromValue(storedValue);
        }

        return string.Empty;
    }

    private string StoredConsoleValue() => access.WebConsoleUrl?.Trim() ?? string.Empty;

    private string BuildConsoleUrlFromValue(string value)
    {
        value = value.Trim();
        if (IsHttpUrl(value))
        {
            return value;
        }

        if (IsGuacamoleProvider() && !string.IsNullOrWhiteSpace(WebRdpBaseUrl()))
        {
            return BuildGuacamoleUrl(value);
        }

        return string.Empty;
    }

    private string BuildWebRdpUrl()
    {
        if (IsGuacamoleProvider())
        {
            var connectionId = GuacamoleConnectionId();
            return string.IsNullOrWhiteSpace(connectionId) ? string.Empty : BuildGuacamoleUrl(connectionId);
        }

        return BuildWebRdpUrlFromTemplate(WebRdpPathTemplate());
    }

    private string BuildGuacamoleUrl(string connectionIdOrPath)
    {
        var baseUrl = WebRdpBaseUrl().Trim().TrimEnd('/');
        if (string.IsNullOrWhiteSpace(baseUrl))
        {
            return string.Empty;
        }

        var value = connectionIdOrPath.Trim();
        if (IsHttpUrl(value))
        {
            return value;
        }

        var template = WebRdpPathTemplate();
        if (string.IsNullOrWhiteSpace(template) || !template.Contains("{connectionId}", StringComparison.OrdinalIgnoreCase))
        {
            template = "/#/client/{connectionId}";
        }

        // Guacamole connection IDs are already URL-safe and may contain route separators.
        // Preserve them exactly so copied values from /#/client/... continue to work.
        var cleanConnectionId = value.TrimStart('/');
        var path = template.Replace("{connectionId}", cleanConnectionId, StringComparison.OrdinalIgnoreCase);

        return baseUrl + "/" + path.TrimStart('/');
    }

    private string BuildWebRdpUrlFromTemplate(string? template)
    {
        var baseUrl = WebRdpBaseUrl().Trim().TrimEnd('/');
        if (string.IsNullOrWhiteSpace(baseUrl))
        {
            return string.Empty;
        }

        var host = !string.IsNullOrWhiteSpace(access.IpAddress) ? access.IpAddress : access.Hostname;
        var port = access.RdpPort is null or <= 0 ? "3389" : access.RdpPort.Value.ToString();
        var address = string.IsNullOrWhiteSpace(host) ? string.Empty : $"{host}:{port}";

        if (string.IsNullOrWhiteSpace(template))
        {
            template = "/";
        }

        template = template
            .Replace("{vm}", Uri.EscapeDataString(vm?.Name ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{host}", Uri.EscapeDataString(host ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{ip}", Uri.EscapeDataString(access.IpAddress ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{hostname}", Uri.EscapeDataString(access.Hostname ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{port}", Uri.EscapeDataString(port), StringComparison.OrdinalIgnoreCase)
            .Replace("{address}", Uri.EscapeDataString(address), StringComparison.OrdinalIgnoreCase)
            .Replace("{username}", Uri.EscapeDataString(access.Username ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{password}", Uri.EscapeDataString(access.Password ?? string.Empty), StringComparison.OrdinalIgnoreCase)
            .Replace("{security}", Uri.EscapeDataString(WebRdpSecurity()), StringComparison.OrdinalIgnoreCase)
            .Replace("{connectionId}", GuacamoleConnectionId().TrimStart('/'), StringComparison.OrdinalIgnoreCase);

        if (Uri.TryCreate(template, UriKind.Absolute, out var absoluteTemplate))
        {
            return absoluteTemplate.ToString();
        }

        return baseUrl + "/" + template.TrimStart('/');
    }

    private string ConsoleModeText()
    {
        if (UseGuacamoleJsonAuth())
        {
            return "Embedded Guacamole auto-login console";
        }

        if (HasWebConsoleUrl() && WebRdpPreferPerVmUrl())
        {
            return IsGuacamoleProvider() ? "Embedded Guacamole console" : "Embedded per-VM web console URL";
        }

        if (WebRdpEnabled() && WebRdpEmbedInConsole() && !string.IsNullOrWhiteSpace(WebRdpBaseUrl()))
        {
            return IsGuacamoleProvider() ? "Embedded Guacamole console" : "Embedded web RDP gateway";
        }

        if (HasWebConsoleUrl())
        {
            return IsGuacamoleProvider() ? "Embedded Guacamole console" : "Embedded per-VM web console URL";
        }

        return "Native .RDP launcher";
    }

