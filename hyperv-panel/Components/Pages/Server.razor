    {
        if (!ShouldRunHyperVConsole())
        {
            return;
        }

        hyperVConsoleDotNetRef ??= DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync(
                "penguinHyperVConsole.bind",
                hyperVConsoleSurface,
                hyperVConsoleDotNetRef);
