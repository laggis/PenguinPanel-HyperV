    private async Task RequestReinstall()
    {
        if (vm is null) return;
        await RunPanelAction(async () =>
        {
            await Panel.RequestReinstallAsync(Session.User, vm.Name, selectedTemplateId, reinstallNotes);
            message = "Reinstall request created.";
            selectedTemplateId = 0;
            reinstallNotes = "";
            await Load();
        });
    }

    private async Task RunDirectReinstallNow()
    {
        if (vm is null || selectedTemplateId == 0 || reinstallInProgress) return;

        var templateNameForConfirm = templates.FirstOrDefault(t => t.Id == selectedTemplateId)?.Name ?? "selected template";
        var confirmationText = Session.User!.IsAdmin
            ? $"Reinstall {vm.Name} from template '{templateNameForConfirm}'?\n\nPenguinPanel will stop the VM, replace its primary disk with a fresh copy of the selected VHDX template, preserve the old disk file, start it again, and re-apply the saved Network / port profile."
            : $"Reinstall your server from '{templateNameForConfirm}' now?\n\nThis will erase the current OS/data on the server disk, temporarily take the server offline, install the selected template, then start the server again automatically.";

        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmationText);

        if (!confirmed)
        {
            return;
        }

        await RunReinstallWithProgress(selectedTemplateId, templateNameForConfirm);
    }

    private async Task RunReinstallWithProgress(long templateId, string templateName)
    {
        if (vm is null) return;

        busy = true;
        reinstallInProgress = true;
        reinstallProgress = 5;
        reinstallStatus = "Preparing reinstall...";
        reinstallCompletionNote = string.Empty;
        message = null;
        messageClass = "alert success";
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(150);
            reinstallProgress = 20;
            reinstallStatus = "Stopping the virtual server and preparing a fresh OS disk...";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(250);
            reinstallProgress = 45;
            reinstallStatus = $"Applying template {templateName}...";
            reinstallCompletionNote = TemplateClientNote(templateId);
            await InvokeAsync(StateHasChanged);

            var result = await Panel.RunDirectReinstallAsync(Session.User, vm.Name, templateId, startAfter: true, notes: reinstallNotes);

            reinstallProgress = 80;
            reinstallStatus = "Re-applying network and remote desktop settings...";
            await InvokeAsync(StateHasChanged);

            await Load(false);

            reinstallProgress = 100;
            reinstallStatus = string.IsNullOrWhiteSpace(reinstallCompletionNote)
                ? "Reinstall completed. Your server is starting again."
                : $"Reinstall completed. Your server is starting again. {reinstallCompletionNote}";
            message = string.IsNullOrWhiteSpace(reinstallCompletionNote)
                ? result.Message
                : $"{result.Message} {reinstallCompletionNote}";
            lastAction = message;
            selectedTemplateId = 0;
            reinstallNotes = "";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1200);
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
            lastAction = ex.Message;
            reinstallProgress = 100;
            reinstallStatus = "Reinstall failed: " + ex.Message;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1600);
        }
        finally
        {
            reinstallInProgress = false;
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

