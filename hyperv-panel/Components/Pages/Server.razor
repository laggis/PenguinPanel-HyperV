        if (!confirmed) return;

        await RunPanelAction(async () =>
        {
            await Panel.DeleteQuickRestorePointAsync(Session.User, vm.Name, point.Id);
            message = $"Quick Restore Point '{point.Name}' deleted.";
            lastAction = message;
            await LoadCheckpoints();
        });
    }

    private async Task CleanupExpiredSnapshots()
