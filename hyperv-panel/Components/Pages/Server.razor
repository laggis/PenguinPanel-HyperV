        if (HasEffectiveWebConsoleUrl())
        {
            return IsGuacamoleProvider()
                ? "The console is using Guacamole. If it does not embed because of browser/cookie restrictions, press Open in new tab."
                : "The console is using a web RDP gateway. If the iframe is blank, open it in a new tab and check gateway/reverse-proxy settings.";
