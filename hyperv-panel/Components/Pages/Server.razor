    private async Task VerifyRdpListener()
    {
        if (vm is null) return;
        rdpListenerChecking = true;
        try
        {
            await RunPanelAction(async () =>
            {
                rdpListenerStatus = await Panel.GetVmRdpListenerStatusAsync(Session.User, vm.Name);
                var expected = networkProfile.RdpInternalPort <= 0 ? 3389 : networkProfile.RdpInternalPort;
                messageClass = rdpListenerStatus.IsReady && rdpListenerStatus.Port == expected ? "alert success" : "alert";
                message = rdpListenerStatus.IsReady
                    ? rdpListenerStatus.Port == expected
                        ? $"Windows RDP is listening correctly on TCP {rdpListenerStatus.Port}."
                        : $"Windows RDP is listening on TCP {rdpListenerStatus.Port}, but PenguinPanel WinNAT expects internal TCP {expected}. Use Match Windows RDP to public port, or update the Network profile."
                    : $"Windows RDP check completed on TCP {rdpListenerStatus.Port}, but one or more required RDP components are not ready.";
                lastAction = message;
            });
        }
        finally
        {
            rdpListenerChecking = false;
        }
    }

    private async Task SyncRdpPortToPublic()
