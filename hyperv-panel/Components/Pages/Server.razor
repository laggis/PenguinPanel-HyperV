        pendingReinstallWindowsPassword = string.Empty;
        pendingReinstallPasswordWillBeGenerated = false;
    }

    private async Task RunReinstallWithProgress(
        long templateId,
        string templateName,
        string requestedWindowsPassword)
    {
        if (vm is null) return;

        busy = true;
        reinstallInProgress = true;
        reinstallProgress = 5;
        reinstallStatus = "Preparing Smart Reinstall...";
        reinstallCompletionNote = string.Empty;
        message = null;
        messageClass = "alert success";
        await InvokeAsync(StateHasChanged);

        try
        {
            reinstallCompletionNote = TemplateClientNote(templateId);

            async Task Progress(int percent, string status)
            {
                reinstallProgress = percent;
                reinstallStatus = status;
                await InvokeAsync(StateHasChanged);
            }

            var result = await Panel.RunDirectReinstallAsync(
                Session.User,
                vm.Name,
                templateId,
                startAfter: true,
                notes: reinstallNotes,
                requestedWindowsPassword: requestedWindowsPassword,
                progress: Progress);

            await Progress(99, "Refreshing the VPS state...");
            await Load(false);

            reinstallProgress = 100;
            reinstallStatus = "Reinstall completed. Your server is ready to use.";
            message = result.Message;
            lastAction = message;
            selectedTemplateId = 0;
            reinstallNotes = "";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1200);
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
            lastAction = ex.Message;
            reinstallProgress = 100;
            reinstallStatus = "Reinstall stopped: " + ex.Message;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1600);
        }
        finally
        {
            reinstallInProgress = false;
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

