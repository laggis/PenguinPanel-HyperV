    private async Task RestoreCheckpoint(VmQuickRestorePointInfo point)
    {
        if (vm is null || restoreInProgress) return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Restore '{point.Name}'?\n\nPenguinPanel will first create a lightweight temporary Safety Restore Point for the CURRENT VM state, then apply this restore point. If the VM is running now, PenguinPanel will start it again after the restore.");

        if (!confirmed) return;

        busy = true;
        restoreInProgress = true;
        restoreProgress = 5;
        restoreStatus = "Preparing Quick Restore...";
        messageClass = "alert success";
        message = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            restoreProgress = 15;
            restoreStatus = "Creating lightweight safety restore point for the current VM state...";
            await InvokeAsync(StateHasChanged);

            var result = await Panel.RestoreQuickRestorePointAsync(
                Session.User,
                vm.Name,
                point.Id);

            restoreProgress = 85;
            restoreStatus = "Restore applied. Refreshing VM state and restore points...";
            await InvokeAsync(StateHasChanged);

            await Load();
            await LoadBackups();

            restoreProgress = 100;
            restoreStatus = result.Message;
            message = result.Message;
            lastAction = result.Message;
        }
        catch (Exception ex)
        {
            messageClass = "alert";
            message = ex.Message;
            lastAction = ex.Message;
            restoreStatus = "Restore failed: " + ex.Message;
        }
        finally
        {
            restoreInProgress = false;
            busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleSnapshotPin(VmQuickRestorePointInfo point)
    {
        if (vm is null || point.IsTemporarySafety) return;

        if (!point.IsPinned)
        {
            var currentPermanent = quickRestorePoints.FirstOrDefault(item =>
                item.IsPinned
                && !item.IsTemporarySafety
                && !string.Equals(item.Id, point.Id, StringComparison.OrdinalIgnoreCase));

            var prompt = currentPermanent is null
                ? $"Make '{point.Name}' the permanent restore point?\n\nIt will not expire and will be excluded from expired cleanup."
                : $"Replace permanent restore point '{currentPermanent.Name}' with '{point.Name}'?\n\n'{currentPermanent.Name}' will become a normal restore point again and normal age retention will apply to it.";

            var confirmed = await JS.InvokeAsync<bool>("confirm", prompt);
            if (!confirmed) return;
        }
        else
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"Remove permanent protection from '{point.Name}'?\n\nIt will become a normal restore point and normal age retention will apply.");

            if (!confirmed) return;
        }

        await RunPanelAction(async () =>
        {
            await Panel.SetQuickRestorePointPinnedAsync(
                Session.User,
                vm.Name,
                point.Id,
                !point.IsPinned);

            message = point.IsPinned
                ? $"Permanent protection removed from '{point.Name}'."
                : $"'{point.Name}' is now the permanent restore point.";
            lastAction = message;
            await LoadCheckpoints();
        });
    }

