    private string NetworkProfilePreview()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(profileInternalIp))
        {
            parts.Add($"internal {profileInternalIp}");
        }
        if (profileEnableRdp && profileRdpExternalPort is > 0)
        {
            parts.Add($"RDP {PublicEndpoint(profileRdpExternalPort)} → {profileInternalIp}:{profileRdpInternalPort}");
        }
        if (profileEnableFiveM && profileFiveMExternalPort is > 0)
        {
            parts.Add($"FiveM TCP/UDP {PublicEndpoint(profileFiveMExternalPort)} → {profileInternalIp}:{profileFiveMInternalPort}");
        }
        if (!string.IsNullOrWhiteSpace(profileExtraTcpPorts) || !string.IsNullOrWhiteSpace(profileExtraUdpPorts))
        {
            parts.Add("extra custom ports enabled");
        }
        if (!string.IsNullOrWhiteSpace(profilePreferredDns) || !string.IsNullOrWhiteSpace(profileAlternateDns))
        {
            var dns = string.Join(", ", new[] { profilePreferredDns, profileAlternateDns }.Where(item => !string.IsNullOrWhiteSpace(item)));
            parts.Add($"guest DNS {dns}");
        }

        return parts.Count == 0
            ? "No port rules configured yet. Fill Internal VM IPv4 and the ports you want PenguinPanel to preserve."
            : string.Join(" • ", parts);
    }

